{
  "name": "@treklink/developer-docs",
  "version": "0.1.0",
  "private": true,
  "description": "TrekLink developer documentation for the organization API, served at /developers/",
  "scripts": {
    "gen": "docusaurus clean-api-docs all && docusaurus gen-api-docs all",
    "start": "npm run gen && docusaurus start",
    "build": "npm run gen && docusaurus build",
    "serve": "docusaurus serve --no-open",
    "clear": "docusaurus clear && docusaurus clean-api-docs all",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "~3.10.2",
    "@docusaurus/preset-classic": "~3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.89.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "~3.10.2",
    "@docusaurus/tsconfig": "~3.10.2",
    "@docusaurus/types": "~3.10.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
