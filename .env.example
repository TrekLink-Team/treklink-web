# TrekLink Web Platform, environment variables example
# Copy to .env in local development

# PostgreSQL Database (Backend & Prisma), D-010
#
# The database is selected by these two variables only; no code path picks one any other way.
#   DATABASE_URL         the connection the running backend uses
#   DATABASE_DIRECT_URL  the connection `prisma migrate` uses (datasource directUrl)
#
# Local Docker Postgres (docker-compose.yml), for development and tests: both are the same string.
# Neon (shared dev and demo): DATABASE_URL is the pooled string (host contains "-pooler"),
# DATABASE_DIRECT_URL is the direct string. Neon strings live in ignore/{name}/envs/, never here.
# The team's Neon branch is `dev` (D-062). `neon env pull` writes the direct string as
# DATABASE_URL_UNPOOLED; copy that value into DATABASE_DIRECT_URL, which is what schema.prisma reads.
#
# Both are required (REQ-OPT-02): the backend refuses to start without either, and Prisma CLI
# commands other than `prisma generate` fail with P1012 when DATABASE_DIRECT_URL is unset.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/treklink?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/treklink?schema=public"

# MQTT Broker (Gateway & Backend)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID_GATEWAY="treklink-gateway-bridge"
MQTT_CLIENT_ID_BACKEND="treklink-backend-service"
# Backend ingestion (gateway-sync). MQTT_INGESTION_ENABLED=false runs the backend without a broker.
# MQTT_INGESTION_ENABLED="true"
# MQTT_ROOT="treklink"
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Service Ports
PORT_BACKEND=3000
PORT_FRONTEND=5173
PORT_GATEWAY=3001

# Authentication & Security (names per specs/auth/requirements.md §4; validated at boot by the
# platform module, which refuses to start on a missing or malformed value)
JWT_ACCESS_SECRET="treklink_access_token_secret_development_key_change_in_production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="14d"
# Optional and unused: refresh tokens are opaque and stored as SHA-256 (D-060 rule 6).
# JWT_REFRESH_SECRET=

# Outbound mail (auth task 1.3, D-063 rules 3 and 4). `console` writes each email, code included, to
# the server log, for development and CI; the backend refuses to start with it when
# NODE_ENV=production. `smtp` sends through SMTP_URL, for the team Gmail account
# smtps://treklink.team%40gmail.com:<app password>@smtp.gmail.com:465 (D-063 rule 10). The app
# password comes only in the team env zip; set it in .env only, and never the account password.
# MAIL_TRANSPORT="console"                  # console | smtp
# MAIL_FROM="TrekLink <no-reply@treklink.local>"
# SMTP_URL=

# Demo seed (backend/prisma/seed-demo.ts, `npm --prefix backend run seed:demo`). One password per demo
# account, admin@, staff@, manager@ and operator@treklink.local; at least auth.passwordMinLength (8)
# characters. Set them in .env only, never here. BCRYPT_COST defaults to 12.
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_OPERATOR_PASSWORD=
# BCRYPT_COST=12

# Backend platform settings (specs/platform/requirements.md §4). All optional; defaults shown.
# NODE_ENV="development"                    # development | test | production
# CORS_ORIGINS="http://localhost:5173"      # comma-separated
# HTTP_BODY_LIMIT="1mb"
# SWAGGER_ENABLED="true"                    # default: true unless NODE_ENV=production
# PARAMETER_CACHE_TTL_SECONDS=30
# HEALTH_DB_TIMEOUT_MS=2000                 # GET /api/health reports 503 when SELECT 1 is slower
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100
# DISPLAY_TIMEZONE_DEFAULT="Asia/Ho_Chi_Minh"

# Frontend API & WebSocket URLs
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_WS_URL="http://localhost:3000"
# Environment badge in the app header (convention 06 §8 item 10): sandbox, staging or production;
# unset shows Sandbox.
VITE_APP_ENV="sandbox"

# Map provider: the frontend reads tiles, attribution, viewport and the sovereignty overlay labels
# from GET /api/map/config (D-031), so no VITE_MAP_* variable exists. Changing the provider needs a
# fresh sovereignty check over ~16.5N 112.0E and ~9.7N 114.0E, with screenshots filed as evidence.

# Gateway Configuration (D-015: no operational parameter is a code literal)
GATEWAY_SQLITE_DB_PATH="./data/gateway_queue.db"
GATEWAY_SERIAL_PORT="/dev/ttyUSB0"
GATEWAY_SERIAL_BAUD=115200
GATEWAY_SERIAL_SIMULATION="true"

# Offline priority queue. On overflow the lowest tier sheds first; P0 SOS never sheds (E02-5).
GATEWAY_QUEUE_PEEK_LIMIT=10
GATEWAY_QUEUE_FLUSH_BATCH_SIZE=20
GATEWAY_QUEUE_MAX_SIZE=100000
GATEWAY_QUEUE_SHED_FROM_TIER=3

# Gateway MQTT publishing (Stage B, D-005): each packet goes out on its node's own uplink topic,
# <prefix>/<channel>/<sender>, the topic the backend ingests. The queue still flushes P0 first.
GATEWAY_MQTT_TOPIC_PREFIX="treklink/2/json"
GATEWAY_MQTT_CHANNEL="LongFast"
GATEWAY_MQTT_RECONNECT_PERIOD_MS=3000
GATEWAY_MQTT_QOS=1

# Simulation mode only: simulated nodes (TL-0009 and TL-0010 of the demo seed), tick, SOS cadence and
# the start of the walk.
GATEWAY_SIM_NODES="!de000009,!de00000a"
GATEWAY_SIM_INTERVAL_MS=5000
GATEWAY_SIM_SOS_EVERY=12
GATEWAY_SIM_START_LAT=11.5544
GATEWAY_SIM_START_LON=108.5381

# Where the backend stores signed handover notes (rentals task 2.4), relative to backend/.
HANDOVER_NOTE_STORAGE_DIR="storage/handover-notes"
