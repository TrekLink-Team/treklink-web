# TrekLink Web Platform, environment variables example
# Copy to .env in local development

# PostgreSQL Database (Backend & Prisma), D-010
#
# The database is selected by these two variables only; no code path picks one any other way.
#   DATABASE_URL         the connection the running backend uses
#   DATABASE_DIRECT_URL  the connection `prisma migrate` uses (datasource directUrl)
#
# Local Docker Postgres (docker-compose.yml), for development and tests: both are the same string.
# Neon (shared dev and demo): DATABASE_URL is the pooled string (host contains "-pooler"),
# DATABASE_DIRECT_URL is the direct string. Neon strings live in ignore/{name}/envs/, never here.
#
# Both are required (REQ-OPT-02): the backend refuses to start without either, and Prisma CLI
# commands other than `prisma generate` fail with P1012 when DATABASE_DIRECT_URL is unset.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/treklink?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/treklink?schema=public"

# MQTT Broker (Gateway & Backend)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID_GATEWAY="treklink-gateway-bridge"
MQTT_CLIENT_ID_BACKEND="treklink-backend-service"

# Service Ports
PORT_BACKEND=3000
PORT_FRONTEND=5173
PORT_GATEWAY=3001

# Authentication & Security (names per specs/auth/requirements.md §4; validated at boot by the
# platform module, which refuses to start on a missing or malformed value)
JWT_ACCESS_SECRET="treklink_access_token_secret_development_key_change_in_production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="treklink_refresh_token_secret_development_key"
JWT_REFRESH_TTL="7d"

# Backend platform settings (specs/platform/requirements.md §4). All optional; defaults shown.
# NODE_ENV="development"                    # development | test | production
# CORS_ORIGINS="http://localhost:5173"      # comma-separated
# HTTP_BODY_LIMIT="1mb"
# SWAGGER_ENABLED="true"                    # default: true unless NODE_ENV=production
# PARAMETER_CACHE_TTL_SECONDS=30
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100
# DISPLAY_TIMEZONE_DEFAULT="Asia/Ho_Chi_Minh"

# Frontend API & WebSocket URLs
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_WS_URL="http://localhost:3000"

# Map provider (D-012), provider-agnostic: any MapLibre-compatible style.json works.
#
# LEGAL: Nghi dinh 174/2026/ND-CP Art. 93(3)(a) fines 30-40M VND, and permits forced removal of
# the application, for publishing a map of Vietnam that does not fully or correctly depict national
# sovereignty. OpenStreetMap and other global default tile sources label Hoang Sa / Truong Sa with
# foreign toponyms and MUST NOT be used. There is deliberately no hardcoded fallback: if these are
# unset the map fails loudly rather than silently rendering a non-compliant basemap.
#
# Goong issues TWO distinct credentials:
#   Map Key -> style/tile URLs (VITE_MAP_KEY below)
#   API Key -> Autocomplete / Direction / Geocoding / Distance Matrix / Place Detail
# Restrict the Map Key with an HTTP-referer allowlist + per-IP rate limit; it is browser-visible.
#
# Style variants: goong_map_web (full icons) | goong_map_highlight (minimal) | goong_satellite
VITE_MAP_PROVIDER="goong"
VITE_MAP_STYLE_URL="https://tiles.goong.io/assets/goong_map_web.json"
VITE_MAP_KEY="your_goong_map_key_here"
VITE_MAP_ATTRIBUTION="© Goong Maps"

# Default viewport: Ta Nang trekking region. [lng, lat] order, MapLibre convention.
VITE_MAP_CENTER_LNG=108.5381
VITE_MAP_CENTER_LAT=11.5544
VITE_MAP_ZOOM=13
VITE_MAP_MIN_ZOOM=5
VITE_MAP_MAX_ZOOM=18

# Gateway Configuration (D-015: no operational parameter is a code literal)
GATEWAY_SQLITE_DB_PATH="./data/gateway_queue.db"
GATEWAY_SERIAL_PORT="/dev/ttyUSB0"
GATEWAY_SERIAL_BAUD=115200
GATEWAY_SERIAL_SIMULATION="true"

# Offline priority queue. On overflow the lowest tier sheds first; P0 SOS never sheds (E02-5).
GATEWAY_QUEUE_PEEK_LIMIT=10
GATEWAY_QUEUE_FLUSH_BATCH_SIZE=20
GATEWAY_QUEUE_MAX_SIZE=100000
GATEWAY_QUEUE_SHED_FROM_TIER=3

# Gateway MQTT publishing. Tier is appended to the prefix: <prefix>/0..3
GATEWAY_MQTT_TOPIC_PREFIX="treklink/events/priority"
GATEWAY_MQTT_RECONNECT_PERIOD_MS=3000
GATEWAY_MQTT_QOS=1
