// TrekLink Operations Platform — Prisma Schema
// Single Source of Truth for Database Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  GUIDE
  CUSTOMER
}

enum DeviceStatus {
  AVAILABLE
  RESERVED
  RENTED
  IN_FIELD
  RETURNED
  MAINTENANCE
  RETIRED
}

enum RentalStatus {
  BOOKED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IncidentStatus {
  DETECTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PriorityTier {
  P0_SOS
  P1_LOCATION
  P2_GPS
  P3_TELEMETRY
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  role          Role            @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  rentals       Rental[]
  assignedTrips Trip[]          @relation("GuideTrips")
  audits        IncidentAudit[]

  @@map("users")
}

model Device {
  id              String         @id @default(uuid())
  hardwareVariant String // v1, v2, v3, v4
  macAddress      String?        @unique
  nodeNum         Int?           @unique // Meshtastic node integer ID
  status          DeviceStatus   @default(AVAILABLE)
  batteryPct      Int?
  lastSeenAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  rentals         Rental[]
  incidents       Incident[]
  gatewayEvents   GatewayEvent[]

  @@map("devices")
}

model Trip {
  id        String     @id @default(uuid())
  title     String
  route     String // e.g., Ta Nang - Phan Dung
  startDate DateTime
  endDate   DateTime
  status    TripStatus @default(SCHEDULED)
  guideId   String?
  guide     User?      @relation("GuideTrips", fields: [guideId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  rentals   Rental[]
  incidents Incident[]

  @@map("trips")
}

model Rental {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  deviceId         String
  device           Device       @relation(fields: [deviceId], references: [id])
  tripId           String?
  trip             Trip?        @relation(fields: [tripId], references: [id])
  status           RentalStatus @default(BOOKED)
  startDate        DateTime
  endDate          DateTime
  depositAmount    Decimal      @default(0.0)
  actualReturnDate DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("rentals")
}

model Incident {
  id          String          @id @default(uuid())
  eventId     String          @unique // STALE — pre-D-006 conflated key. Must split: drop this
  // @unique, add openedByEventId FK -> GatewayEvent, lastEventAt,
  // detectionConfidence. See specs/gateway-sync/design.md §1.2,
  // tasks.md Phase 1 (not yet migrated).
  deviceId    String
  device      Device          @relation(fields: [deviceId], references: [id])
  tripId      String?
  trip        Trip?           @relation(fields: [tripId], references: [id])
  status      IncidentStatus  @default(DETECTED)
  latitude    Float?
  longitude   Float?
  altitude    Float?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  audits      IncidentAudit[]

  @@map("incidents")
}

model IncidentAudit {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User           @relation(fields: [actorId], references: [id])
  fromStatus IncidentStatus
  toStatus   IncidentStatus
  actionNote String?
  createdAt  DateTime       @default(now())

  @@map("incident_audits")
}

model GatewayEvent {
  id          String       @id @default(uuid())
  eventId     String       @unique // sha256(nodeNum:packetId) — D-006. The firmware transmits
  // neither sessionId nor sequenceNumber; do not reintroduce
  // that formula. See 00-project-context/03-decisions-and-risk-register.md.
  deviceId    String
  device      Device       @relation(fields: [deviceId], references: [id])
  priority    PriorityTier @default(P3_TELEMETRY)
  payload     Json
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@map("gateway_events")
}

// ─── platform (specs/platform/design.md §4.4, §4.5) ──────────────────────────────────────

enum ParameterType {
  INT
  DECIMAL
  PERCENT
  DURATION_SECONDS
  BOOL
  JSON
}

// Runtime business parameter, editable by Admin (UC-19, D-015). Keys are declared in
// platform/parameters/parameter-registry.ts and seeded with their defaults.
model BusinessParameter {
  key         String                     @id // "rentals.customerHoldMinutes"
  value       Json
  valueType   ParameterType
  bounds      Json? // { "min": 1, "max": 120 }
  unit        String?
  ownerModule String
  description String
  version     Int                        @default(1)
  updatedById String?
  updatedAt   DateTime                   @updatedAt
  history     BusinessParameterHistory[]

  @@map("business_parameters")
}

// Append-only change history of a business parameter (REQ-EVT-03, api-design/04).
model BusinessParameterHistory {
  id            String            @id @default(uuid())
  key           String
  parameter     BusinessParameter @relation(fields: [key], references: [key])
  previousValue Json
  newValue      Json
  changedById   String
  reason        String?
  changedAt     DateTime          @default(now())

  @@map("business_parameter_history")
}

// Generic append-only audit log fed by `audit.record` domain events (UC-20, REQ-EVT-02).
// The database rejects UPDATE and DELETE on this table (REQ-UBI-07).
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorRoles  String[]
  action      String // "booking.confirm", "user.roles.update"
  subjectType String
  subjectId   String?
  before      Json?
  after       Json?
  requestId   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}
