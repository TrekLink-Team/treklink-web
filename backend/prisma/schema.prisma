// TrekLink Rental Platform, Prisma schema.
// Single source of truth for database models (D-001).
//
// Written from Report 3 SRS §3.1.6 (ERD) and §3.1.7 (state machines), treklink-docs D-033 to
// D-037, and the Prisma block in each module's design.md §1. Every model sits under the
// `// @module <name>` marker of the module that owns it. `backend/scripts/check-module-boundaries.js`
// reads those markers and fails lint when code under src/modules/<a>/ touches a model owned by <b>
// (NFR-MNT-01).
//
// Schema rules (specs/platform/design.md §3.4):
// - Columns keep the Prisma field names (camelCase); only table names are mapped.
// - Every reference column is a foreign key, and every foreign-key column leads an index.
//   Exceptions, with no FK: polymorphic references (AuditLog.subjectId, DeviceTransition.refId,
//   ContractTransition.refId), SyncAuditLog.eventId (a rejected attempt may have no event), and
//   values that are not row ids (RefreshToken.familyId, AuditLog.requestId).
// - Tenant-owned rows carry `organizationId`, and every read of them filters by it
//   (04-architecture-conventions.md, tenant isolation; FR-AUTH-11).
// - Money is an integer number of VND in a BigInt column.
// - onDelete is Prisma's default except where stated.
// - Every DateTime is timestamptz(3).
// Constraints Prisma cannot express (CHECK, partial unique, append-only triggers) are raw SQL in
// the initial migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// @module platform ─────────────────────────────────────────────────────────────────────────
// specs/platform/design.md §4.4, §4.5

enum ParameterType {
  INT
  DECIMAL
  PERCENT
  DURATION_SECONDS
  BOOL
  JSON
}

// Runtime business parameter, editable by Admin (UC-57, D-015). Keys are declared in
// platform/parameters/parameter-registry.ts and seeded with their defaults.
model BusinessParameter {
  key         String                     @id // "incidents.primaryAckTimeoutSeconds"
  value       Json
  valueType   ParameterType
  bounds      Json? // { "min": 1, "max": 120 }
  unit        String?
  ownerModule String
  description String
  version     Int                        @default(1)
  updatedById String?
  updatedBy   User?                      @relation("BusinessParameter_updatedById", fields: [updatedById], references: [id])
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  history     BusinessParameterHistory[]

  @@index([updatedById])
  @@map("business_parameters")
}

// Append-only change history of a business parameter (FR-CFG-02, REQ-EVT-03).
model BusinessParameterHistory {
  id            String            @id @default(uuid())
  key           String
  parameter     BusinessParameter @relation(fields: [key], references: [key])
  previousValue Json
  newValue      Json
  changedById   String
  changedBy     User              @relation(fields: [changedById], references: [id])
  reason        String?
  changedAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@index([key, changedAt])
  @@index([changedById])
  @@map("business_parameter_history") // append-only trigger
}

// Generic append-only audit log fed by `audit.record` domain events (UC-58, REQ-EVT-02).
model AuditLog {
  id             String        @id @default(uuid())
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  actorRoles     String[]
  organizationId String? // the tenant the action belongs to; null for platform-wide actions
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String // "contract.approve", "member.deactivate"
  subjectType    String
  subjectId      String?
  before         Json?
  after          Json?
  requestId      String?
  ip             String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_log") // append-only trigger (REQ-UBI-07)
}

// @module auth ─────────────────────────────────────────────────────────────────────────────
// specs/auth/design.md §1

enum AccountType {
  TREKLINK // TrekLink Staff and Admin
  ORGANIZATION // Org Manager and Org Operator
}

enum OtpPurpose {
  SET_PASSWORD // invitation and first sign-in
  PASSWORD_RESET
}

enum AuthEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  PASSWORD_SET
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ACCOUNT_LOCKED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
}

// Any account. Email is the login key (SRS Table 74). Soft-deleted (FR-AUTH-09).
model User {
  id               String      @id @default(uuid())
  email            String      @unique // stored lower-case
  fullName         String
  phoneNumber      String?
  passwordHash     String? // null until the invitation code is used
  accountType      AccountType
  isActive         Boolean     @default(true)
  lastLoginAt      DateTime?   @db.Timestamptz(3)
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?   @db.Timestamptz(3)
  createdById      String?
  createdBy        User?       @relation("User_createdById", fields: [createdById], references: [id])
  deletedAt        DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  oneTimeCodes     OneTimeCode[]
  authEvents       AuthEvent[]
  auditLogs        AuditLog[]
  parameterChanges BusinessParameterHistory[]
  membership       OrganizationMember?

  businessParametersAsUpdatedBy BusinessParameter[] @relation("BusinessParameter_updatedById")
  usersAsCreatedBy              User[]              @relation("User_createdById")
  userRolesAsGrantedBy          UserRole[]          @relation("UserRole_grantedById")

  organizationsAsVerifiedBy Organization[]           @relation("Organization_verifiedById")
  organizationsAsApprovedBy Organization[]           @relation("Organization_decidedById")
  organizationTransitions   OrganizationTransition[]
  membersAsInvitedBy        OrganizationMember[]     @relation("OrganizationMember_invitedById")
  apiKeysAsCreatedBy        ApiKey[]                 @relation("ApiKey_createdById")
  apiKeysAsRevokedBy        ApiKey[]                 @relation("ApiKey_revokedById")
  fieldStationsAsCreatedBy  FieldStation[]           @relation("FieldStation_createdById")
  fieldStationsAsRevokedBy  FieldStation[]           @relation("FieldStation_revokedById")
  rosterShiftsAsCreatedBy   RosterShift[]            @relation("RosterShift_createdById")

  devicesAsRegisteredBy Device[]             @relation("Device_registeredById")
  deviceTransitions     DeviceTransition[]
  intakeChecks          IntakeCheck[]
  deviceProvisionings   DeviceProvisioning[]
  deviceResets          DeviceReset[]
  inspections           Inspection[]
  maintenanceAsOpenedBy MaintenanceRecord[]  @relation("MaintenanceRecord_openedById")
  maintenanceAsClosedBy MaintenanceRecord[]  @relation("MaintenanceRecord_closedById")
  stockTakes            StockTake[]

  contractsAsRequestedBy       RentalContract[]     @relation("RentalContract_requestedById")
  contractsAsDecidedBy         RentalContract[]     @relation("RentalContract_decidedById")
  contractsAsHandedOverBy      RentalContract[]     @relation("RentalContract_handedOverById")
  contractsAsNoticeBy          RentalContract[]     @relation("RentalContract_noticeGivenById")
  contractsAsClosedBy          RentalContract[]     @relation("RentalContract_closedById")
  contractTransitions          ContractTransition[]
  contractDevicesAsCheckedInBy ContractDevice[]     @relation("ContractDevice_checkedInById")

  priceSchedules         PriceSchedule[]
  damageRates            DamageRate[]
  paymentsAsRecordedBy   Payment[]       @relation("Payment_recordedById")
  paymentsAsRequestedBy  Payment[]       @relation("Payment_requestedById")
  damageChargesAsDecided DamageCharge[]  @relation("DamageCharge_decidedById")
  invoiceAdjustments     InvoiceLine[]   @relation("InvoiceLine_createdById")

  incidentsAsOwner      Incident[]             @relation("Incident_ownerId")
  incidentTransitions   IncidentTransition[]
  incidentStatusUpdates IncidentStatusUpdate[]
  alertsAsRecipient     AlertDelivery[]
  authorityReports      AuthorityReport[]      @relation("AuthorityReport_reportedById")
  authorityCasesClosed  AuthorityReport[]      @relation("AuthorityReport_caseClosedById")

  @@index([accountType, isActive])
  @@index([createdById])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique // ADMIN, STAFF, ORG_MANAGER, ORG_OPERATOR
  name        String
  accountType AccountType // which account type may hold it
  isSystem    Boolean          @default(false) // system roles cannot be deleted
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id         String           @id @default(uuid())
  key        String           @unique // stable seed key, e.g. "incident.acknowledge.ownOrganization"
  action     String
  subject    String // Organization, RentalContract, Incident, ... or 'all'
  conditions Json? // CASL conditions with ${user.*} placeholders, e.g. { organizationId: "${user.organizationId}" }
  fields     String[]
  inverted   Boolean          @default(false)
  reason     String?
  roles      RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id])
  grantedById String?
  grantedBy   User?    @relation("UserRole_grantedById", fields: [grantedById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                        String         @id @default(uuid())
  userId                    String
  user                      User           @relation(fields: [userId], references: [id])
  familyId                  String // one per login; revoked as a unit (FR-AUTH-03)
  tokenHash                 String         @unique // sha256 of the opaque token
  expiresAt                 DateTime       @db.Timestamptz(3)
  revokedAt                 DateTime?      @db.Timestamptz(3)
  replacedById              String?
  replacedBy                RefreshToken?  @relation("RefreshToken_replacedById", fields: [replacedById], references: [id])
  userAgent                 String?
  ip                        String?
  createdAt                 DateTime       @default(now()) @db.Timestamptz(3)
  refreshTokensAsReplacedBy RefreshToken[] @relation("RefreshToken_replacedById")

  @@index([userId, familyId])
  @@index([replacedById])
  @@map("refresh_tokens")
}

model OneTimeCode {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.Timestamptz(3)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, createdAt])
  @@map("one_time_codes")
}

// Authentication audit (FR-AUTH-08). Never holds an attempted password.
model AuthEvent {
  id        String        @id @default(uuid())
  userId    String? // null when the email matched no account
  user      User?         @relation(fields: [userId], references: [id])
  email     String? // lower-cased login identifier as submitted
  type      AuthEventType
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events") // append-only trigger
}

// @module organizations ────────────────────────────────────────────────────────────────────
// specs/organizations/design.md §1

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

enum MemberRole {
  MANAGER
  OPERATOR
}

model Organization {
  id                 String             @id @default(uuid())
  code               String             @unique // ORG-0007
  legalName          String
  taxCode            String             @unique
  address            String
  contactEmail       String
  contactPhone       String
  status             OrganizationStatus @default(PENDING)
  statusChangedAt    DateTime           @default(now()) @db.Timestamptz(3)
  // verification at the TrekLink counter or by phone (FR-ORG-02)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  verifiedById       String?
  verifiedBy         User?              @relation("Organization_verifiedById", fields: [verifiedById], references: [id])
  verificationMethod String? // IN_PERSON, PHONE
  documentsSeen      String[]
  masterContractRef  String? // number printed on the signed master contract
  // Admin decision (FR-ORG-03)
  decidedAt          DateTime?          @db.Timestamptz(3)
  decidedById        String?
  decidedBy          User?              @relation("Organization_decidedById", fields: [decidedById], references: [id])
  rejectionReason    String?
  suspensionReason   String?
  // organization channel key version written to its devices at provisioning (FR-DEV-05, D-021)
  channelKeyVersion  Int                @default(1)
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  members       OrganizationMember[]
  transitions   OrganizationTransition[]
  rosterShifts  RosterShift[]
  apiKeys       ApiKey[]
  fieldStations FieldStation[]
  auditLogs     AuditLog[]

  contracts           RentalContract[]
  invoices            Invoice[]
  payments            Payment[]
  incidents           Incident[]
  deviceProvisionings DeviceProvisioning[]
  fieldEvents         FieldEvent[]
  streamEvents        StreamEvent[]

  @@index([status])
  @@index([verifiedById])
  @@index([decidedById])
  @@map("organizations")
}

// One organization account belongs to exactly one organization (FR-ORG-04).
model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           MemberRole
  invitedById    String?
  invitedBy      User?        @relation("OrganizationMember_invitedById", fields: [invitedById], references: [id])
  deactivatedAt  DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  shiftsAsPrimary RosterShift[] @relation("RosterShift_primaryMemberId")
  shiftsAsBackup  RosterShift[] @relation("RosterShift_backupMemberId")

  @@index([organizationId, role])
  @@index([invitedById])
  @@map("organization_members")
}

model OrganizationTransition {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  fromStatus     OrganizationStatus?
  toStatus       OrganizationStatus
  actorId        String? // null = SYSTEM (default on a contract)
  actor          User?               @relation(fields: [actorId], references: [id])
  reason         String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("organization_transitions") // append-only trigger
}

// A shift window with its primary and backup on-duty member (FR-ORG-05, BR-16).
model RosterShift {
  id              String              @id @default(uuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  startsAt        DateTime            @db.Timestamptz(3)
  endsAt          DateTime            @db.Timestamptz(3)
  primaryMemberId String?
  primaryMember   OrganizationMember? @relation("RosterShift_primaryMemberId", fields: [primaryMemberId], references: [id])
  backupMemberId  String?
  backupMember    OrganizationMember? @relation("RosterShift_backupMemberId", fields: [backupMemberId], references: [id])
  createdById     String
  createdBy       User                @relation("RosterShift_createdById", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@index([organizationId, startsAt, endsAt])
  @@index([primaryMemberId])
  @@index([backupMemberId])
  @@index([createdById])
  @@map("roster_shifts") // exclusion constraint: no overlapping shifts per organization
}

// Read-only telemetry API key (FR-ORG-06). Only the hash is stored.
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  prefix         String // first 8 characters, shown in lists
  keyHash        String       @unique // sha256 of the full key
  createdById    String
  createdBy      User         @relation("ApiKey_createdById", fields: [createdById], references: [id])
  lastUsedAt     DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  revokedById    String?
  revokedBy      User?        @relation("ApiKey_revokedById", fields: [revokedById], references: [id])
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, revokedAt])
  @@index([createdById])
  @@index([revokedById])
  @@map("api_keys")
}

// Field Station credential, self-service by the Org Manager (D-037, FR-EVT-14). The MQTT broker
// authenticates the station by mqttUsername and the secret checked against secretHash.
model FieldStation {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  mqttUsername     String       @unique // fs-<org code>-<n>
  secretHash       String
  createdById      String
  createdBy        User         @relation("FieldStation_createdById", fields: [createdById], references: [id])
  revokedAt        DateTime?    @db.Timestamptz(3)
  revokedById      String?
  revokedBy        User?        @relation("FieldStation_revokedById", fields: [revokedById], references: [id])
  // health projection written by gateway-sync through OrganizationsService (FR-EVT-13)
  lastSyncAt       DateTime?    @db.Timestamptz(3)
  queueDepth       Int[] // index 0 = P0 .. 3 = P3
  oldestRetryCount Int?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  fieldEvents FieldEvent[]

  @@index([organizationId, revokedAt])
  @@index([createdById])
  @@index([revokedById])
  @@map("field_stations")
}

// @module devices ──────────────────────────────────────────────────────────────────────────
// specs/devices/design.md §1

enum DeviceStatus {
  IN_INTAKE
  AVAILABLE
  RESERVED
  RENTED
  RETURNED
  MAINTENANCE
  LOST
  RETIRED
}

enum MaintenanceStatus {
  OPEN
  COMPLETED
  UNREPAIRABLE
}

enum InspectionResult {
  PASSED
  DAMAGED // passes function checks, damage charged
  FAILED // goes to maintenance
}

model HardwareVariant {
  id                     String   @id @default(uuid())
  code                   String   @unique // treklink-v1 .. treklink-v4
  name                   String
  hasGps                 Boolean
  hasMotionSensor        Boolean // v2 and v4; drives the intake check (FR-DEV-03)
  mqttCapable            Boolean // false for v1: -D MESHTASTIC_EXCLUDE_MQTT=1
  firmwareBaseline       String
  // remaining value by age in whole months, descending; the first row at or below the age wins
  // (FR-BILL-05): [{ "fromMonths": 0, "valueVnd": 2500000 }, { "fromMonths": 12, ... }]
  remainingValueSchedule Json
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  devices        Device[]
  contracts      RentalContract[]
  priceSchedules PriceSchedule[]
  damageRates    DamageRate[]

  @@map("hardware_variants")
}

// A physical unit with two identities registered at intake and never reused (D-035).
model Device {
  id                String          @id @default(uuid())
  assetTag          String          @unique // printed label, e.g. TL-0042
  nodeNum           BigInt          @unique // unsigned 32-bit radio identity from the MAC
  hardwareVariantId String
  hardwareVariant   HardwareVariant @relation(fields: [hardwareVariantId], references: [id])
  firmwareVersion   String
  acquiredAt        DateTime        @db.Timestamptz(3) // age basis for the remaining value
  status            DeviceStatus    @default(IN_INTAKE)
  statusChangedAt   DateTime        @default(now()) @db.Timestamptz(3)
  // provisioning: the version of the organization channel key on the device, never the key
  keyVersion        Int?
  keyOrganizationId String? // whose key is on the device; cleared by the reset (FR-DEV-07)
  provisionedAt     DateTime?       @db.Timestamptz(3)
  // projection written by gateway-sync through DevicesService (FR-DEV-06)
  lastSeenAt        DateTime?       @db.Timestamptz(3)
  batteryPct        Int?
  lastLatitude      Float?
  lastLongitude     Float?
  registeredById    String
  registeredBy      User            @relation("Device_registeredById", fields: [registeredById], references: [id])
  retiredAt         DateTime?       @db.Timestamptz(3)
  version           Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  transitions        DeviceTransition[]
  intakeChecks       IntakeCheck[]
  provisionings      DeviceProvisioning[]
  resets             DeviceReset[]
  inspections        Inspection[]
  maintenanceRecords MaintenanceRecord[]
  contractDevices    ContractDevice[]
  fieldEvents        FieldEvent[]
  syncAudits         SyncAuditLog[]
  queueReports       DeviceQueueReport[]
  incidents          Incident[]
  invoiceLines       InvoiceLine[]
  damageCharges      DamageCharge[]

  @@index([status])
  @@index([hardwareVariantId, status])
  @@index([registeredById])
  @@map("devices")
}

model DeviceTransition {
  id         String        @id @default(uuid())
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id])
  fromStatus DeviceStatus? // null for the registration row
  toStatus   DeviceStatus
  actorId    String? // null = SYSTEM
  actor      User?         @relation(fields: [actorId], references: [id])
  reason     String // REGISTERED, INTAKE_PASSED, RESERVED, HANDED_OVER, CHECKED_IN, ...
  note       String?
  refType    String? // CONTRACT, INTAKE_CHECK, INSPECTION, MAINTENANCE
  refId      String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([actorId])
  @@map("device_transitions") // append-only trigger
}

// Intake check on registration and after maintenance (FR-DEV-03).
model IntakeCheck {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  gpsFixOk    Boolean
  radioOk     Boolean
  batteryOk   Boolean
  motionOk    Boolean? // null when the variant has no motion sensor
  passed      Boolean
  note        String?
  checkedById String
  checkedBy   User     @relation(fields: [checkedById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([checkedById])
  @@map("intake_checks") // append-only trigger
}

// The organization channel key written to a device at handover (FR-DEV-05). Version only.
model DeviceProvisioning {
  id              String       @id @default(uuid())
  deviceId        String
  device          Device       @relation(fields: [deviceId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  keyVersion      Int
  provisionedById String
  provisionedBy   User         @relation(fields: [provisionedById], references: [id])
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([organizationId])
  @@index([provisionedById])
  @@map("device_provisionings") // append-only trigger
}

// The logged reset on return (FR-DEV-07, BR-28).
model DeviceReset {
  id            String   @id @default(uuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id])
  keyRemoved    Boolean
  nodeDbCleared Boolean
  ownerCleared  Boolean
  resetById     String
  resetBy       User     @relation(fields: [resetById], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([resetById])
  @@map("device_resets") // append-only trigger
}

// Inspection after check-in and reset (UC-44). A DAMAGED result feeds billing (FR-BILL-04).
model Inspection {
  id               String           @id @default(uuid())
  deviceId         String
  device           Device           @relation(fields: [deviceId], references: [id])
  contractDeviceId String?
  contractDevice   ContractDevice?  @relation(fields: [contractDeviceId], references: [id])
  result           InspectionResult
  damageCodes      String[] // keys of DamageRate.code
  note             String?
  inspectorId      String
  inspector        User             @relation(fields: [inspectorId], references: [id])
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  damageCharges DamageCharge[]

  @@index([deviceId, createdAt])
  @@index([contractDeviceId])
  @@index([inspectorId])
  @@map("inspections") // append-only trigger
}

model MaintenanceRecord {
  id          String            @id @default(uuid())
  deviceId    String
  device      Device            @relation(fields: [deviceId], references: [id])
  reason      String // INTAKE_FAILED, INSPECTION_FAILED, HANDOVER_CHECK_FAILED, SCHEDULED, STAFF_REPORTED
  status      MaintenanceStatus @default(OPEN)
  description String
  resolution  String?
  openedById  String
  openedBy    User              @relation("MaintenanceRecord_openedById", fields: [openedById], references: [id])
  closedById  String?
  closedBy    User?             @relation("MaintenanceRecord_closedById", fields: [closedById], references: [id])
  openedAt    DateTime          @default(now()) @db.Timestamptz(3)
  closedAt    DateTime?         @db.Timestamptz(3)

  @@index([deviceId, status])
  @@index([openedById])
  @@index([closedById])
  @@map("maintenance_records")
}

// A stock-take run (FR-DEV-10): the scanned tags and the computed result, kept as evidence.
model StockTake {
  id          String   @id @default(uuid())
  scannedTags String[]
  result      Json // { inStockConfirmed, rentedSeen, unconfirmed: [assetTag] }
  takenById   String
  takenBy     User     @relation(fields: [takenById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([takenById])
  @@map("stock_takes")
}

// @module rentals ──────────────────────────────────────────────────────────────────────────
// specs/rentals/design.md §1

enum PlanType {
  MONTHLY
  DAY
}

enum ContractStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  ENDING
  RETURN_DUE
  OVERDUE
  DEFAULTED
  RETURNED
  CLOSED
}

enum TermStatus {
  OPEN
  CLOSED
}

model RentalContract {
  id                   String          @id @default(uuid())
  code                 String          @unique // RC-2026-0042
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id])
  planType             PlanType
  dayPlanDays          Int? // 3, 4 or 7 for a day plan (rentals.dayPlanLengths)
  hardwareVariantId    String
  hardwareVariant      HardwareVariant @relation(fields: [hardwareVariantId], references: [id])
  quantity             Int
  requestedStartDate   DateTime        @db.Date
  // price snapshot at request time (FR-CFG-02: a price change applies only to later requests)
  monthlyUnitPriceVnd  BigInt
  dayPremium           Decimal?        @db.Decimal(5, 2)
  holdingFeeRatio      Decimal         @db.Decimal(4, 3)
  status               ContractStatus  @default(REQUESTED)
  statusChangedAt      DateTime        @default(now()) @db.Timestamptz(3)
  requestedById        String
  requestedBy          User            @relation("RentalContract_requestedById", fields: [requestedById], references: [id])
  decidedById          String?
  decidedBy            User?           @relation("RentalContract_decidedById", fields: [decidedById], references: [id])
  decidedAt            DateTime?       @db.Timestamptz(3)
  rejectionReason      String?
  reservationExpiresAt DateTime?       @db.Timestamptz(3) // FR-CON-04
  cancelledAt          DateTime?       @db.Timestamptz(3)
  cancelReason         String?
  // handover (FR-CON-05, FR-CON-06, D-037)
  handedOverAt         DateTime?       @db.Timestamptz(3)
  handedOverById       String?
  handedOverBy         User?           @relation("RentalContract_handedOverById", fields: [handedOverById], references: [id])
  identityChecked      String? // document type and last digits seen at the counter
  handoverNotePath     String? // stored PDF
  handoverNoteSha256   String?
  // end of contract
  endsAt               DateTime?       @db.Timestamptz(3) // day plan end, or the term end after notice
  noticeGivenAt        DateTime?       @db.Timestamptz(3)
  noticeGivenById      String?
  noticeGivenBy        User?           @relation("RentalContract_noticeGivenById", fields: [noticeGivenById], references: [id])
  returnDueAt          DateTime?       @db.Timestamptz(3)
  overdueAt            DateTime?       @db.Timestamptz(3)
  defaultedAt          DateTime?       @db.Timestamptz(3)
  returnedAt           DateTime?       @db.Timestamptz(3)
  closedAt             DateTime?       @db.Timestamptz(3)
  closedById           String?
  closedBy             User?           @relation("RentalContract_closedById", fields: [closedById], references: [id])
  version              Int             @default(0)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  terms            ContractTerm[]
  devices          ContractDevice[]
  transitions      ContractTransition[]
  invoices         Invoice[]
  payments         Payment[]
  incidents        Incident[]
  authorityReports AuthorityReport[]

  @@index([organizationId, status])
  @@index([status, returnDueAt])
  @@index([hardwareVariantId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([handedOverById])
  @@index([noticeGivenById])
  @@index([closedById])
  @@map("rental_contracts")
}

// One monthly term; a day plan has exactly one term (SRS Table 74).
model ContractTerm {
  id         String         @id @default(uuid())
  contractId String
  contract   RentalContract @relation(fields: [contractId], references: [id])
  seq        Int // 1, 2, 3
  startsAt   DateTime       @db.Timestamptz(3)
  endsAt     DateTime       @db.Timestamptz(3)
  status     TermStatus     @default(OPEN)
  closedAt   DateTime?      @db.Timestamptz(3)
  invoice    Invoice?

  @@unique([contractId, seq])
  @@map("contract_terms") // CHECK endsAt > startsAt
}

// A device committed to a contract (BR-03: at most one live row per device).
model ContractDevice {
  id                     String         @id @default(uuid())
  contractId             String
  contract               RentalContract @relation(fields: [contractId], references: [id])
  deviceId               String
  device                 Device         @relation(fields: [deviceId], references: [id])
  reservedAt             DateTime       @default(now()) @db.Timestamptz(3)
  releasedAt             DateTime?      @db.Timestamptz(3) // cancelled before handover, or swapped
  handedOverAt           DateTime?      @db.Timestamptz(3)
  checkedInAt            DateTime?      @db.Timestamptz(3)
  checkedInById          String?
  checkedInBy            User?          @relation("ContractDevice_checkedInById", fields: [checkedInById], references: [id])
  lostAt                 DateTime?      @db.Timestamptz(3)
  // optional holder label (FR-CON-14, BR-33); erased when the contract closes
  holderName             String?
  holderPhone            String?
  holderEmergencyContact String?

  inspections Inspection[]

  @@index([contractId])
  @@index([deviceId])
  @@index([checkedInById])
  @@map("contract_devices") // partial unique: one live row per device
}

model ContractTransition {
  id         String          @id @default(uuid())
  contractId String
  contract   RentalContract  @relation(fields: [contractId], references: [id])
  fromStatus ContractStatus?
  toStatus   ContractStatus
  actorId    String? // null = SYSTEM
  actor      User?           @relation(fields: [actorId], references: [id])
  reason     String?
  refType    String?
  refId      String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([contractId, createdAt])
  @@index([actorId])
  @@map("contract_transitions") // append-only trigger
}

// @module billing ──────────────────────────────────────────────────────────────────────────
// specs/billing/design.md §1

enum InvoiceKind {
  TERM // a monthly term: holding fee line and balance line
  DAY_PLAN
  CLOSING // late, damage and loss charges at the end of the contract
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
}

enum InvoiceLineType {
  HOLDING_FEE
  TERM_BALANCE
  DAY_PLAN_FEE
  LATE_FEE
  DAMAGE
  LOSS
  ADJUSTMENT
}

enum PaymentMethod {
  SEPAY
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING // SePay request created, waiting for the webhook
  CONFIRMED
  FAILED
  EXPIRED
}

enum DamageChargeStatus {
  PENDING_APPROVAL
  APPROVED
  REDUCED
  WAIVED
}

// Monthly price per device by variant, effective from a time (UC-56). Append-only; the latest
// row with effectiveFrom <= now is current.
model PriceSchedule {
  id                String          @id @default(uuid())
  hardwareVariantId String
  hardwareVariant   HardwareVariant @relation(fields: [hardwareVariantId], references: [id])
  monthlyPriceVnd   BigInt
  effectiveFrom     DateTime        @db.Timestamptz(3)
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([hardwareVariantId, effectiveFrom])
  @@index([createdById])
  @@map("price_schedules") // append-only trigger
}

// The damage schedule (FR-BILL-04): a fixed amount per damage code, optionally per variant.
model DamageRate {
  id                String           @id @default(uuid())
  code              String // CASING_CRACKED, ANTENNA_BROKEN, ...
  label             String
  hardwareVariantId String?
  hardwareVariant   HardwareVariant? @relation(fields: [hardwareVariantId], references: [id])
  amountVnd         BigInt
  isActive          Boolean          @default(true)
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([code, hardwareVariantId])
  @@index([hardwareVariantId])
  @@index([createdById])
  @@map("damage_rates")
}

// Immutable once issued (FR-BILL-06); corrections are ADJUSTMENT lines on the closing invoice.
model Invoice {
  id             String         @id @default(uuid())
  number         String         @unique // INV-2026-000123
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  contractId     String
  contract       RentalContract @relation(fields: [contractId], references: [id])
  termId         String?        @unique
  term           ContractTerm?  @relation(fields: [termId], references: [id])
  kind           InvoiceKind
  status         InvoiceStatus  @default(ISSUED)
  totalVnd       BigInt
  paidVnd        BigInt         @default(0)
  issuedAt       DateTime       @default(now()) @db.Timestamptz(3)

  lines    InvoiceLine[]
  payments Payment[]

  @@index([organizationId, status])
  @@index([contractId])
  @@map("invoices")
}

model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id])
  seq         Int
  type        InvoiceLineType
  description String
  deviceId    String?
  device      Device?         @relation(fields: [deviceId], references: [id])
  quantity    Int             @default(1)
  unitVnd     BigInt
  amountVnd   BigInt
  dueAt       DateTime        @db.Timestamptz(3)
  paidVnd     BigInt          @default(0)
  createdById String?
  createdBy   User?           @relation("InvoiceLine_createdById", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([invoiceId, seq])
  @@index([deviceId])
  @@index([createdById])
  @@index([dueAt])
  @@map("invoice_lines")
}

// One payment against an invoice. `reference` is unique: a repeated webhook or a repeated counter
// entry records nothing (FR-BILL-08, BR-31).
model Payment {
  id             String         @id @default(uuid())
  reference      String         @unique // TL<base32>, issued by the system for SePay; receipt number at the counter
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  contractId     String
  contract       RentalContract @relation(fields: [contractId], references: [id])
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id])
  amountVnd      BigInt
  method         PaymentMethod
  status         PaymentStatus
  isSandbox      Boolean        @default(true) // BR-34
  gatewayTxnId   String?        @unique // SePay transaction id from the webhook
  gatewayPayload Json?
  failureReason  String?
  requestedById  String?
  requestedBy    User?          @relation("Payment_requestedById", fields: [requestedById], references: [id])
  recordedById   String? // Staff for a counter payment
  recordedBy     User?          @relation("Payment_recordedById", fields: [recordedById], references: [id])
  expiresAt      DateTime?      @db.Timestamptz(3)
  confirmedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([contractId])
  @@index([invoiceId])
  @@index([requestedById])
  @@index([recordedById])
  @@map("payments")
}

// A damage charge from an inspection, held for approval above the threshold (FR-BILL-04, BR-24).
model DamageCharge {
  id           String             @id @default(uuid())
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id])
  deviceId     String
  device       Device             @relation(fields: [deviceId], references: [id])
  amountVnd    BigInt // from the damage schedule
  finalVnd     BigInt? // after approval, reduction or waiver
  status       DamageChargeStatus
  decidedById  String?
  decidedBy    User?              @relation("DamageCharge_decidedById", fields: [decidedById], references: [id])
  decisionNote String?
  decidedAt    DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  @@index([inspectionId])
  @@index([deviceId])
  @@index([decidedById])
  @@index([status])
  @@map("damage_charges")
}

// @module incidents ────────────────────────────────────────────────────────────────────────
// specs/incidents/design.md §1, D-034

enum IncidentState {
  DETECTED
  NOTIFY_PRIMARY
  NOTIFY_BACKUP
  NOTIFY_MANAGER
  UNROUTED
  ESCALATED
  REPORTED
  ACKNOWLEDGED
  RESPONDING
  RESOLVED
  FALSE_ALARM
  CLOSED
}

enum IncidentSource {
  DEVICE_SOS
  DEVICE_FALL
  CADENCE_INFERRED
}

enum IncidentConfidence {
  CONFIRMED
  SUSPECTED
}

enum AlertChannel {
  WEB
  WEBSOCKET
  EMAIL
  API_EVENT
}

enum AlertStatus {
  PENDING
  SENT
  FAILED // retries exhausted
}

model Incident {
  id                 String             @id @default(uuid())
  code               String             @unique // INC-2026-000045
  deviceId           String
  device             Device             @relation(fields: [deviceId], references: [id])
  // routing, fixed at creation (FR-INC-03); null when UNROUTED
  contractId         String?
  contract           RentalContract?    @relation(fields: [contractId], references: [id])
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  state              IncidentState      @default(DETECTED)
  stateChangedAt     DateTime           @default(now()) @db.Timestamptz(3)
  source             IncidentSource
  confidence         IncidentConfidence
  openedByEventId    String?            @unique
  openedByEvent      FieldEvent?        @relation("Incident_openedByEventId", fields: [openedByEventId], references: [eventId])
  firstEventAt       DateTime           @db.Timestamptz(3)
  lastEventAt        DateTime           @db.Timestamptz(3) // correlation window anchor
  eventCount         Int                @default(1)
  lastLatitude       Float?
  lastLongitude      Float?
  // owner and timers (NFR-REL-07: every non-terminal state has an owner or a pending deadline)
  ownerId            String?
  owner              User?              @relation("Incident_ownerId", fields: [ownerId], references: [id])
  tierDeadlineAt     DateTime?          @db.Timestamptz(3) // NOTIFY_* acknowledge timeout
  statusDueAt        DateTime?          @db.Timestamptz(3) // ACKNOWLEDGED / RESPONDING stale limit
  reopenWindowEndsAt DateTime?          @db.Timestamptz(3) // RESOLVED / FALSE_ALARM
  stale              Boolean            @default(false) // device silent during the incident (FR-INC-13)
  acknowledgedAt     DateTime?          @db.Timestamptz(3) // time-to-acknowledge basis
  resolvedAt         DateTime?          @db.Timestamptz(3) // time-to-resolve basis
  outcomeNote        String?
  falseAlarmReason   String?
  reopenCount        Int                @default(0)
  closedAt           DateTime?          @db.Timestamptz(3)
  version            Int                @default(0) // compare-and-set (D-034 rule 1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  transitions      IncidentTransition[]
  alerts           AlertDelivery[]
  statusUpdates    IncidentStatusUpdate[]
  authorityReports AuthorityReport[]
  events           FieldEvent[]           @relation("FieldEvent_incidentId")

  @@index([deviceId, state, lastEventAt]) // correlation lookup
  @@index([organizationId, state])
  @@index([contractId])
  @@index([state, tierDeadlineAt])
  @@index([state, statusDueAt])
  @@index([state, reopenWindowEndsAt])
  @@index([ownerId])
  @@map("incidents")
}

model IncidentTransition {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  seq        Int // 1, 2, 3 per incident
  fromState  IncidentState?
  toState    IncidentState
  actorId    String? // null = SYSTEM
  actor      User?          @relation(fields: [actorId], references: [id])
  reason     String // CREATED, ROUTED, TIER_TIMEOUT, ACKNOWLEDGED, STALE_LIMIT, ...
  note       String?
  refEventId String?
  refEvent   FieldEvent?    @relation("IncidentTransition_refEventId", fields: [refEventId], references: [eventId])
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  alerts AlertDelivery[]

  @@unique([incidentId, seq])
  @@index([actorId])
  @@index([refEventId])
  @@map("incident_transitions") // append-only trigger
}

// Status reports during a response (UC-33). Append-only.
model IncidentStatusUpdate {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  note       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([incidentId, createdAt])
  @@index([authorId])
  @@map("incident_status_updates") // append-only trigger
}

// Outbox row written in the transition's transaction, delivered after commit (D-034 rule 3).
model AlertDelivery {
  id            String             @id @default(uuid())
  incidentId    String
  incident      Incident           @relation(fields: [incidentId], references: [id])
  transitionId  String
  transition    IncidentTransition @relation(fields: [transitionId], references: [id])
  tier          String // PRIMARY, BACKUP, MANAGER, TREKLINK, OWNER
  recipientId   String? // null for an API_EVENT to the organization's stream
  recipient     User?              @relation(fields: [recipientId], references: [id])
  channel       AlertChannel
  status        AlertStatus        @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @db.Timestamptz(3)
  lastError     String?
  sentAt        DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([incidentId])
  @@index([transitionId])
  @@index([recipientId])
  @@map("alert_deliveries")
}

// A report to the authorities (FR-INC-10, BR-17): on an ESCALATED or UNROUTED incident, or on a
// DEFAULTED contract.
model AuthorityReport {
  id             String          @id @default(uuid())
  incidentId     String?
  incident       Incident?       @relation(fields: [incidentId], references: [id])
  contractId     String?
  contract       RentalContract? @relation(fields: [contractId], references: [id])
  agency         String
  reference      String
  reportedAt     DateTime        @db.Timestamptz(3)
  reportedById   String
  reportedBy     User            @relation("AuthorityReport_reportedById", fields: [reportedById], references: [id])
  note           String?
  caseClosedAt   DateTime?       @db.Timestamptz(3)
  caseClosedById String?
  caseClosedBy   User?           @relation("AuthorityReport_caseClosedById", fields: [caseClosedById], references: [id])
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([incidentId])
  @@index([contractId])
  @@index([reportedById])
  @@index([caseClosedById])
  @@map("authority_reports") // CHECK exactly one of incidentId, contractId
}

// @module gateway-sync ─────────────────────────────────────────────────────────────────────
// specs/gateway-sync/design.md §1

enum PriorityTier {
  P0_SOS
  P1_LOCATION
  P2_GPS
  P3_TELEMETRY
}

enum EventKind {
  SOS
  FALL_SOS
  POSITION
  TELEMETRY
  CHAT
}

enum IngressPath {
  MQTT_NODE // Stage A and B: the node's own uplink
  FIELD_STATION // Stage C
}

enum SyncOutcome {
  ACCEPTED
  DUPLICATE_REJECTED
  MALFORMED_ENVELOPE
  NORMALIZATION_FAILED
  UNKNOWN_DEVICE
  NOT_RENTED_TO_STATION_ORG // FR-EVT-14: the station's organization does not rent this device
  INVALID_POSITION
  IMPLAUSIBLE_POSITION // FR-MON-04: persisted, not projected, not plotted
  QUEUE_REPORT // Stage B health packet, no FieldEvent
}

// Append-only ledger of accepted field events and the telemetry history.
model FieldEvent {
  id             String        @id @default(uuid())
  seq            BigInt        @unique @default(autoincrement()) // ingestion order
  eventId        String        @unique // sha256(nodeNum:packetId), D-006
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id])
  // the renting organization at ingestion time; null when the device was not rented (FR-MON-07)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  fieldStationId String?
  fieldStation   FieldStation? @relation(fields: [fieldStationId], references: [id])
  uplinkKey      String // node id or Field Station MQTT username
  ingress        IngressPath
  kind           EventKind
  priority       PriorityTier
  observedAt     DateTime?     @db.Timestamptz(3) // device rx_time; null when 0 (FR-EVT-08)
  receivedAt     DateTime      @default(now()) @db.Timestamptz(3)
  latitude       Float?
  longitude      Float?
  altitude       Float?
  batteryPct     Int?
  rssi           Int?
  snr            Float?
  hopsAway       Int?
  plotted        Boolean       @default(true) // false for IMPLAUSIBLE_POSITION
  payload        Json // raw payload, persisted verbatim
  incidentId     String? // set when this event opened or joined an episode
  incident       Incident?     @relation("FieldEvent_incidentId", fields: [incidentId], references: [id])

  openedIncident        Incident?            @relation("Incident_openedByEventId")
  transitionsAsRefEvent IncidentTransition[] @relation("IncidentTransition_refEventId")

  @@index([deviceId, receivedAt])
  @@index([deviceId, kind, receivedAt])
  @@index([organizationId, seq])
  @@index([incidentId])
  @@index([fieldStationId])
  @@map("field_events") // append-only trigger, one-way incidentId link allowed
}

// Every ingestion attempt, accepted or not: the evidence base for RQ1 (FR-EVT-11).
model SyncAuditLog {
  id         String      @id @default(uuid())
  eventId    String?
  nodeNum    BigInt?
  deviceId   String?
  device     Device?     @relation(fields: [deviceId], references: [id])
  uplinkKey  String?
  ingress    IngressPath
  outcome    SyncOutcome
  detail     String?
  rawMessage Json?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([outcome, createdAt])
  @@index([eventId])
  @@index([deviceId])
  @@map("sync_audit_log") // append-only trigger
}

// Stage B on-device queue health (NFR-IF-01).
model DeviceQueueReport {
  id               String   @id @default(uuid())
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id])
  schemaVersion    Int
  uptimeSeconds    Int
  capacity         Int
  depth            Int[] // index 0 = P0 .. 3 = P3
  enqueued         Int[]
  published        Int[]
  shed             Int[]
  p0Refused        Int
  flashWriteFailed Int
  restoreDiscarded Int
  rebootDetected   Boolean  @default(false)
  receivedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([deviceId, receivedAt])
  @@map("device_queue_reports")
}

// @module monitoring ───────────────────────────────────────────────────────────────────────
// specs/monitoring/design.md §1

// The organization-scoped live stream, replayable from a cursor (FR-MON-05, FR-MON-06).
// organizationId null = a platform-wide entry visible to TrekLink Staff and Admin only.
model StreamEvent {
  seq            BigInt        @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type           String // device.position, device.telemetry, device.stale, incident.changed, station.stale
  deviceId       String?
  payload        Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([organizationId, seq])
  @@index([createdAt])
  @@map("stream_events") // pruned after monitoring.streamRetentionHours
}
