// TrekLink Rental Platform, Prisma schema.
// Single source of truth for database models (D-001).
//
// Written from Report 3 SRS §3.1.6 (ERD) and §3.1.7 (state machines), treklink-docs D-033 to
// D-037, and the Prisma block in each module's design.md §1. Every model sits under the
// `// @module <name>` marker of the module that owns it. `backend/scripts/check-module-boundaries.js`
// reads those markers and fails lint when code under src/modules/<a>/ touches a model owned by <b>
// (NFR-MNT-01).
//
// Schema rules (specs/platform/design.md §3.4):
// - Columns keep the Prisma field names (camelCase); only table names are mapped.
// - Every reference column is a foreign key, and every foreign-key column leads an index.
//   Exceptions, with no FK: polymorphic references (AuditLog.subjectId, DeviceTransition.refId,
//   ContractTransition.refId), SyncAuditLog.eventId (a rejected attempt may have no event), and
//   values that are not row ids (RefreshToken.familyId, AuditLog.requestId).
// - Tenant-owned rows carry `organizationId`, and every read of them filters by it
//   (04-architecture-conventions.md, tenant isolation; FR-AUTH-11).
// - Money is an integer number of VND in a BigInt column.
// - onDelete is Prisma's default except where stated.
// - Every DateTime is timestamptz(3).
// Constraints Prisma cannot express (CHECK, partial unique, append-only triggers) are raw SQL in
// the initial migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// @module platform ─────────────────────────────────────────────────────────────────────────
// specs/platform/design.md §4.4, §4.5

enum ParameterType {
  INT
  DECIMAL
  PERCENT
  DURATION_SECONDS
  BOOL
  JSON
}

// Runtime business parameter, editable by Admin (UC-57, D-015). Keys are declared in
// platform/parameters/parameter-registry.ts and seeded with their defaults.
model BusinessParameter {
  key         String                     @id // "incidents.primaryAckTimeoutSeconds"
  value       Json
  valueType   ParameterType
  bounds      Json? // { "min": 1, "max": 120 }
  unit        String?
  ownerModule String
  description String
  version     Int                        @default(1)
  updatedById String?
  updatedBy   User?                      @relation("BusinessParameter_updatedById", fields: [updatedById], references: [id])
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  history     BusinessParameterHistory[]

  @@index([updatedById])
  @@map("business_parameters")
}

// Append-only change history of a business parameter (FR-CFG-02, REQ-EVT-03).
model BusinessParameterHistory {
  id            String            @id @default(uuid())
  key           String
  parameter     BusinessParameter @relation(fields: [key], references: [key])
  previousValue Json
  newValue      Json
  changedById   String
  changedBy     User              @relation(fields: [changedById], references: [id])
  reason        String?
  changedAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@index([key, changedAt])
  @@index([changedById])
  @@map("business_parameter_history") // append-only trigger
}

// Generic append-only audit log fed by `audit.record` domain events (UC-58, REQ-EVT-02).
model AuditLog {
  id             String        @id @default(uuid())
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  actorRoles     String[]
  organizationId String? // the tenant the action belongs to; null for platform-wide actions
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String // "contract.approve", "member.deactivate"
  subjectType    String
  subjectId      String?
  before         Json?
  after          Json?
  requestId      String?
  ip             String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_log") // append-only trigger (REQ-UBI-07)
}

// The last request-driven tick run of each scheduled job (platform design §4.6, D-090 rule 1). Written
// only by JobRunnerService.tick, so a host that keeps the in-process timers never writes it.
model JobRun {
  name      String   @id // "monitoring.staleSweep"
  lastRunAt DateTime @db.Timestamptz(3)

  @@map("job_runs")
}

// @module auth ─────────────────────────────────────────────────────────────────────────────
// specs/auth/design.md §1

enum AccountType {
  TREKLINK // TrekLink Staff and Admin
  ORGANIZATION // Org Manager and Org Operator
}

enum OtpPurpose {
  SET_PASSWORD // invitation and first sign-in
  PASSWORD_RESET
}

enum AuthEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  PASSWORD_SET
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ACCOUNT_LOCKED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  // A demo role switch (D-088, specs/demo/design.md §6): a token pair issued without a password.
  DEMO_SWITCH
}

// Any account. Email is the login key (SRS Table 74). Soft-deleted (FR-AUTH-09).
model User {
  id               String      @id @default(uuid())
  email            String      @unique // stored lower-case
  fullName         String
  phoneNumber      String?
  passwordHash     String? // null until the invitation code is used
  accountType      AccountType
  isActive         Boolean     @default(true)
  lastLoginAt      DateTime?   @db.Timestamptz(3)
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?   @db.Timestamptz(3)
  createdById      String?
  createdBy        User?       @relation("User_createdById", fields: [createdById], references: [id])
  deletedAt        DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  oneTimeCodes     OneTimeCode[]
  authEvents       AuthEvent[]
  auditLogs        AuditLog[]
  parameterChanges BusinessParameterHistory[]
  membership       OrganizationMember?

  businessParametersAsUpdatedBy BusinessParameter[] @relation("BusinessParameter_updatedById")
  usersAsCreatedBy              User[]              @relation("User_createdById")
  userRolesAsGrantedBy          UserRole[]          @relation("UserRole_grantedById")

  organizationsAsVerifiedBy Organization[]           @relation("Organization_verifiedById")
  organizationsAsApprovedBy Organization[]           @relation("Organization_decidedById")
  organizationTransitions   OrganizationTransition[]
  membersAsInvitedBy        OrganizationMember[]     @relation("OrganizationMember_invitedById")
  apiKeysAsCreatedBy        ApiKey[]                 @relation("ApiKey_createdById")
  apiKeysAsRevokedBy        ApiKey[]                 @relation("ApiKey_revokedById")
  fieldStationsAsCreatedBy  FieldStation[]           @relation("FieldStation_createdById")
  fieldStationsAsRevokedBy  FieldStation[]           @relation("FieldStation_revokedById")
  rosterShiftsAsCreatedBy   RosterShift[]            @relation("RosterShift_createdById")

  devicesAsRegisteredBy    Device[]             @relation("Device_registeredById")
  deviceTransitions        DeviceTransition[]
  intakeChecks             IntakeCheck[]
  deviceProvisionings      DeviceProvisioning[]
  deviceResets             DeviceReset[]
  inspections              Inspection[]
  maintenanceAsOpenedBy    MaintenanceRecord[]  @relation("MaintenanceRecord_openedById")
  maintenanceAsClosedBy    MaintenanceRecord[]  @relation("MaintenanceRecord_closedById")
  maintenanceAsEstimatedBy MaintenanceRecord[]  @relation("MaintenanceRecord_estimatedById")
  maintenanceAsDecidedBy   MaintenanceRecord[]  @relation("MaintenanceRecord_decidedById")
  stockTakes               StockTake[]

  contractsAsRequestedBy       RentalContract[]     @relation("RentalContract_requestedById")
  contractsAsDecidedBy         RentalContract[]     @relation("RentalContract_decidedById")
  contractsAsHandedOverBy      RentalContract[]     @relation("RentalContract_handedOverById")
  contractsAsNoticeBy          RentalContract[]     @relation("RentalContract_noticeGivenById")
  contractsAsClosedBy          RentalContract[]     @relation("RentalContract_closedById")
  contractTransitions          ContractTransition[]
  contractDevicesAsCheckedInBy ContractDevice[]     @relation("ContractDevice_checkedInById")
  groupsCreated                Group[]
  groupAssignmentsMade         GroupAssignment[]
  deviceFaultReportsFiled      DeviceFaultReport[]

  priceSchedules           PriceSchedule[]
  damageRates              DamageRate[]
  paymentsAsRecordedBy     Payment[]       @relation("Payment_recordedById")
  invoicesAsRefundedBy     Invoice[]       @relation("Invoice_refundedById")
  paymentsAsRequestedBy    Payment[]       @relation("Payment_requestedById")
  damageChargesAsDecided   DamageCharge[]  @relation("DamageCharge_decidedById")
  damageChargesAsInspector DamageCharge[]  @relation("DamageCharge_inspectorId")
  serviceCreditsRequested  ServiceCredit[] @relation("ServiceCredit_requestedById")
  serviceCreditsDecided    ServiceCredit[] @relation("ServiceCredit_decidedById")
  invoiceAdjustments       InvoiceLine[]   @relation("InvoiceLine_createdById")

  incidentsAsOwner      Incident[]             @relation("Incident_ownerId")
  incidentTransitions   IncidentTransition[]
  incidentStatusUpdates IncidentStatusUpdate[]
  alertsAsRecipient     AlertDelivery[]
  authorityReports      AuthorityReport[]      @relation("AuthorityReport_reportedById")
  authorityCasesClosed  AuthorityReport[]      @relation("AuthorityReport_caseClosedById")
  lossCasesReported     LossCase[]             @relation("LossCase_reportedById")
  dockSessionsOpened    DeviceDockSession[]    @relation("DeviceDockSession_openedById")
  hubActionsTaken       DeviceHubAction[]      @relation("DeviceHubAction_actorId")
  lossCasesTriaged      LossCase[]             @relation("LossCase_triagedById")
  lossCasesDecided      LossCase[]             @relation("LossCase_decidedById")
  disposalsVerified     DeviceDisposal[]
  complianceCasesOpened ComplianceCase[]       @relation("ComplianceCase_openedById")
  complianceCasesClosed ComplianceCase[]       @relation("ComplianceCase_closedById")
  complianceActions     ComplianceAction[]

  simulatedNodesCreated SimulatedNode[]
  rolePoliciesUpdated   OrganizationRolePolicy[] @relation("OrganizationRolePolicy_updatedById")

  unitReleases UnitRelease[] @relation("UnitRelease_releasedById")

  @@index([accountType, isActive])
  @@index([createdById])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique // ADMIN, STAFF, ORG_MANAGER, ORG_OPERATOR
  name        String
  accountType AccountType // which account type may hold it
  isSystem    Boolean          @default(false) // system roles cannot be deleted
  permissions RolePermission[]
  users       UserRole[]

  organizationPolicies OrganizationRolePolicy[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // stable seed key, e.g. "incident.respond.own"
  action      String
  subject     String // Organization, RentalContract, Incident, ... or 'all'
  accountType AccountType // the only account type whose roles may hold it (D-057); filled from the catalog's role grants
  conditions  Json? // CASL conditions with ${user.*} placeholders, e.g. { organizationId: "${user.organizationId}" }
  fields      String[]
  inverted    Boolean          @default(false)
  reason      String?
  roles       RolePermission[]

  organizationPolicyRows OrganizationRolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id])
  grantedById String?
  grantedBy   User?    @relation("UserRole_grantedById", fields: [grantedById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// What one organization changed in the permissions of its two roles (D-095, specs/auth/design.md §9). A
// row exists once a Manager has saved the role; no row means version 0 and no difference from the
// baseline of `role_permissions`. `version` counts the saves and is the `expectedVersion` of the next.
model OrganizationRolePolicy {
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role                         @relation(fields: [roleId], references: [id])
  version        Int                          @default(1)
  updatedById    String?
  updatedBy      User?                        @relation("OrganizationRolePolicy_updatedById", fields: [updatedById], references: [id])
  updatedAt      DateTime                     @default(now()) @updatedAt @db.Timestamptz(3)
  permissions    OrganizationRolePermission[]

  @@id([organizationId, roleId])
  @@index([roleId])
  @@index([updatedById])
  @@map("organization_role_policies")
}

// One grant or revoke of a policy: a permission the baseline of the role lacks and the ceiling holds
// (GRANT), or one the baseline holds (REVOKE). Deleted and inserted again with every save.
model OrganizationRolePermission {
  organizationId String
  roleId         String
  permissionId   String
  permission     Permission             @relation(fields: [permissionId], references: [id])
  effect         OrganizationRoleEffect
  policy         OrganizationRolePolicy @relation(fields: [organizationId, roleId], references: [organizationId, roleId], onDelete: Cascade)

  @@id([organizationId, roleId, permissionId])
  @@index([permissionId])
  @@map("organization_role_permissions")
}

enum OrganizationRoleEffect {
  GRANT
  REVOKE
}

model RefreshToken {
  id                        String         @id @default(uuid())
  userId                    String
  user                      User           @relation(fields: [userId], references: [id])
  familyId                  String // one per login; revoked as a unit (FR-AUTH-03)
  tokenHash                 String         @unique // sha256 of the opaque token
  expiresAt                 DateTime       @db.Timestamptz(3)
  revokedAt                 DateTime?      @db.Timestamptz(3)
  replacedById              String?
  replacedBy                RefreshToken?  @relation("RefreshToken_replacedById", fields: [replacedById], references: [id])
  userAgent                 String?
  ip                        String?
  createdAt                 DateTime       @default(now()) @db.Timestamptz(3)
  refreshTokensAsReplacedBy RefreshToken[] @relation("RefreshToken_replacedById")

  @@index([userId, familyId])
  @@index([replacedById])
  @@map("refresh_tokens")
}

model OneTimeCode {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.Timestamptz(3)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, createdAt])
  @@map("one_time_codes")
}

// Authentication audit (FR-AUTH-08). Never holds an attempted password.
model AuthEvent {
  id        String        @id @default(uuid())
  userId    String? // null when the email matched no account
  user      User?         @relation(fields: [userId], references: [id])
  email     String? // lower-cased login identifier as submitted
  type      AuthEventType
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events") // append-only trigger
}

// @module organizations ────────────────────────────────────────────────────────────────────
// specs/organizations/design.md §1

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

enum MemberRole {
  MANAGER
  OPERATOR
}

model Organization {
  id                    String             @id @default(uuid())
  code                  String             @unique // ORG-0007
  legalName             String
  taxCode               String             @unique
  address               String
  contactEmail          String
  contactPhone          String
  status                OrganizationStatus @default(PENDING)
  statusChangedAt       DateTime           @default(now()) @db.Timestamptz(3)
  // verification at the TrekLink counter or by phone (FR-ORG-02)
  verifiedAt            DateTime?          @db.Timestamptz(3)
  verifiedById          String?
  verifiedBy            User?              @relation("Organization_verifiedById", fields: [verifiedById], references: [id])
  verificationMethod    String? // IN_PERSON, PHONE
  documentsSeen         String[]
  masterContractRef     String? // number printed on the signed master contract
  // the master contract includes the NDA and the Field Station software licence (FR-ORG-02, D-046)
  ndaSigned             Boolean            @default(false)
  softwareLicenceSigned Boolean            @default(false)
  // a lost renter device exposed the channel key; cleared when the key is rotated (FR-DEV-13, D-045)
  channelKeyExposedAt   DateTime?          @db.Timestamptz(3)
  // Admin decision (FR-ORG-03)
  decidedAt             DateTime?          @db.Timestamptz(3)
  decidedById           String?
  decidedBy             User?              @relation("Organization_decidedById", fields: [decidedById], references: [id])
  rejectionReason       String?
  suspensionReason      String?
  // organization channel key version written to its devices at provisioning (FR-DEV-05, D-021)
  channelKeyVersion     Int                @default(1)
  version               Int                @default(0)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  members       OrganizationMember[]
  transitions   OrganizationTransition[]
  rosterShifts  RosterShift[]
  apiKeys       ApiKey[]
  fieldStations FieldStation[]
  auditLogs     AuditLog[]

  contracts           RentalContract[]
  invoices            Invoice[]
  payments            Payment[]
  incidents           Incident[]
  deviceProvisionings DeviceProvisioning[]
  fieldEvents         FieldEvent[]
  streamEvents        StreamEvent[]
  complianceCases     ComplianceCase[]
  lossCases           LossCase[]
  serviceCredits      ServiceCredit[]
  rolePolicies        OrganizationRolePolicy[]
  groups              Group[]
  deviceFaultReports  DeviceFaultReport[]

  @@index([status])
  @@index([verifiedById])
  @@index([decidedById])
  @@map("organizations")
}

// One organization account belongs to exactly one organization (FR-ORG-04).
model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           MemberRole
  invitedById    String?
  invitedBy      User?        @relation("OrganizationMember_invitedById", fields: [invitedById], references: [id])
  deactivatedAt  DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  shiftsAsPrimary RosterShift[] @relation("RosterShift_primaryMemberId")
  shiftsAsBackup  RosterShift[] @relation("RosterShift_backupMemberId")

  @@index([organizationId, role])
  @@index([invitedById])
  @@map("organization_members")
}

model OrganizationTransition {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  fromStatus     OrganizationStatus?
  toStatus       OrganizationStatus
  actorId        String? // null = SYSTEM (default on a contract)
  actor          User?               @relation(fields: [actorId], references: [id])
  reason         String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("organization_transitions") // append-only trigger
}

// A shift window with its primary and backup on-duty member (FR-ORG-05, BR-16).
model RosterShift {
  id              String              @id @default(uuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  startsAt        DateTime            @db.Timestamptz(3)
  endsAt          DateTime            @db.Timestamptz(3)
  primaryMemberId String?
  primaryMember   OrganizationMember? @relation("RosterShift_primaryMemberId", fields: [primaryMemberId], references: [id])
  backupMemberId  String?
  backupMember    OrganizationMember? @relation("RosterShift_backupMemberId", fields: [backupMemberId], references: [id])
  createdById     String
  createdBy       User                @relation("RosterShift_createdById", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@index([organizationId, startsAt, endsAt])
  @@index([primaryMemberId])
  @@index([backupMemberId])
  @@index([createdById])
  @@map("roster_shifts") // exclusion constraint: no overlapping shifts per organization
}

// Read-only telemetry API key (FR-ORG-06). Only the hash is stored.
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  prefix         String // first 8 characters, shown in lists
  keyHash        String       @unique // sha256 of the full key
  createdById    String
  createdBy      User         @relation("ApiKey_createdById", fields: [createdById], references: [id])
  lastUsedAt     DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  revokedById    String?
  revokedBy      User?        @relation("ApiKey_revokedById", fields: [revokedById], references: [id])
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, revokedAt])
  @@index([createdById])
  @@index([revokedById])
  @@map("api_keys")
}

// Field Station credential, self-service by the Org Manager (D-037, FR-EVT-14). The MQTT broker
// authenticates the station by mqttUsername and the secret checked against secretHash.
model FieldStation {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  mqttUsername     String       @unique // fs-<org code>-<n>
  secretHash       String
  createdById      String
  createdBy        User         @relation("FieldStation_createdById", fields: [createdById], references: [id])
  revokedAt        DateTime?    @db.Timestamptz(3)
  revokedById      String?
  revokedBy        User?        @relation("FieldStation_revokedById", fields: [revokedById], references: [id])
  // health projection written by gateway-sync through OrganizationsService (FR-EVT-13)
  lastSyncAt       DateTime?    @db.Timestamptz(3)
  queueDepth       Int[] // index 0 = P0 .. 3 = P3
  oldestRetryCount Int?
  version          String? // last reported executable version (FR-EVT-18, D-039)
  lastFlushAt      DateTime?    @db.Timestamptz(3) // the station's last PUBACKed publish, clock-corrected (D-040)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  fieldEvents FieldEvent[]

  @@index([organizationId, revokedAt])
  @@index([createdById])
  @@index([revokedById])
  @@map("field_stations")
}

enum ComplianceCaseType {
  SUSPECTED_FRAUD
  SUSPECTED_THEFT
  IP_VIOLATION
  NDA_BREACH
  OTHER_BREACH
}

enum ComplianceCaseStatus {
  OPEN
  CLOSED
}

enum ComplianceActionKind {
  SUSPEND_ORGANIZATION
  REVOKE_FIELD_STATION
  REVOKE_API_KEY
  OTHER
}

// A suspected fraud, theft, IP violation or NDA breach by an organization (FR-ORG-08, D-046).
// SUSPECTED_FRAUD and SUSPECTED_THEFT close only with an authorityReference (BR-40).
model ComplianceCase {
  id                 String               @id @default(uuid())
  code               String               @unique // CMP-0001
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  type               ComplianceCaseType
  status             ComplianceCaseStatus @default(OPEN)
  evidence           String
  linkedContractIds  String[]
  authorityReference String? // police report reference
  outcome            String?
  openedById         String
  openedBy           User                 @relation("ComplianceCase_openedById", fields: [openedById], references: [id])
  openedAt           DateTime             @default(now()) @db.Timestamptz(3)
  closedById         String?
  closedBy           User?                @relation("ComplianceCase_closedById", fields: [closedById], references: [id])
  closedAt           DateTime?            @db.Timestamptz(3)

  actions   ComplianceAction[]
  lossCases LossCase[]

  @@index([organizationId, status])
  @@index([openedById])
  @@index([closedById])
  @@map("compliance_cases")
}

// Each action taken from a compliance case (FR-ORG-09). Append-only.
model ComplianceAction {
  id        String               @id @default(uuid())
  caseId    String
  case      ComplianceCase       @relation(fields: [caseId], references: [id])
  kind      ComplianceActionKind
  targetId  String? // field station or API key id
  note      String?
  actorId   String
  actor     User                 @relation(fields: [actorId], references: [id])
  createdAt DateTime             @default(now()) @db.Timestamptz(3)

  @@index([caseId, createdAt])
  @@index([actorId])
  @@map("compliance_actions")
}

// @module devices ──────────────────────────────────────────────────────────────────────────
// specs/devices/design.md §1

enum DeviceStatus {
  IN_INTAKE
  AVAILABLE
  RESERVED
  RENTED
  RETURNED
  MAINTENANCE
  LOST
  RETIRED
  DISPOSED // after a verified wipe (FR-DEV-16, D-045)
}

enum MaintenanceStatus {
  OPEN
  PENDING_APPROVAL // estimate or actual cost above devices.maintenanceApprovalThresholdVnd (FR-DEV-20, D-047)
  COMPLETED
  UNREPAIRABLE
}

enum MaintenanceWorkBy {
  IN_HOUSE
  VENDOR
}

enum InspectionResult {
  PASSED
  DAMAGED // passes function checks, damage charged
  FAILED // goes to maintenance
}

model HardwareVariant {
  id                     String   @id @default(uuid())
  code                   String   @unique // treklink-v1 .. treklink-v4
  name                   String
  hasGps                 Boolean
  hasMotionSensor        Boolean // v2 and v4; drives the intake check (FR-DEV-03)
  mqttCapable            Boolean // false for v1: -D MESHTASTIC_EXCLUDE_MQTT=1
  firmwareBaseline       String
  // remaining value by age in whole months, descending; the first row at or below the age wins
  // (FR-BILL-05): [{ "fromMonths": 0, "valueVnd": 2500000 }, { "fromMonths": 12, ... }]
  remainingValueSchedule Json
  serviceIntervalDays    Int? // days between periodic services; null for none (FR-DEV-04, D-047)
  serviceChecklist       String[] @default([]) // items checked at each periodic service
  // Image of the unit: an https URL or an app path under /variants/ (specs/devices/design.md section 10). It
  // names the detail render; the frontend derives the icon render by name. Null shows the labelled empty slot.
  imageUrl               String?
  // Display text only, never behaviour: keys from the fixed list of design section 10, values of 1 to 80
  // characters. The capability flags above drive logic.
  specSheet              Json     @default("{}")
  isActive               Boolean  @default(true)
  version                Int      @default(0) // optimistic lock of the Admin edit (devices design section 11)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  devices        Device[]
  contracts      RentalContract[]
  priceSchedules PriceSchedule[]
  damageRates    DamageRate[]

  @@map("hardware_variants")
}

// A physical unit with two identities registered at intake and never reused (D-035).
model Device {
  id                String          @id @default(uuid())
  assetTag          String          @unique // printed label, e.g. TL-0042
  nodeNum           BigInt          @unique // unsigned 32-bit radio identity from the MAC
  hardwareVariantId String
  hardwareVariant   HardwareVariant @relation(fields: [hardwareVariantId], references: [id])
  firmwareVersion   String
  acquiredAt        DateTime        @db.Timestamptz(3) // age basis for the remaining value
  status            DeviceStatus    @default(IN_INTAKE)
  statusChangedAt   DateTime        @default(now()) @db.Timestamptz(3)
  // provisioning: the version of the organization channel key on the device, never the key
  keyVersion        Int?
  keyOrganizationId String? // whose key is on the device; cleared by the reset (FR-DEV-07)
  provisionedAt     DateTime?       @db.Timestamptz(3)
  // projection written by gateway-sync through DevicesService (FR-DEV-06)
  lastSeenAt        DateTime?       @db.Timestamptz(3)
  batteryPct        Int?
  lastLatitude      Float?
  lastLongitude     Float?
  lastPositionAt    DateTime?       @db.Timestamptz(3) // reading time of lastLatitude/lastLongitude; null when unknown (D-092 rule 2)
  lastBatteryAt     DateTime?       @db.Timestamptz(3) // reading time of batteryPct; null when unknown (D-040)
  registeredById    String
  registeredBy      User            @relation("Device_registeredById", fields: [registeredById], references: [id])
  retiredAt         DateTime?       @db.Timestamptz(3)
  serviceDueAt      DateTime?       @db.Date // next periodic service (FR-DEV-17); null when the variant has no interval
  version           Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  transitions        DeviceTransition[]
  intakeChecks       IntakeCheck[]
  provisionings      DeviceProvisioning[]
  resets             DeviceReset[]
  inspections        Inspection[]
  maintenanceRecords MaintenanceRecord[]
  contractDevices    ContractDevice[]
  groupAssignments   GroupAssignment[]
  faultReports       DeviceFaultReport[]
  fieldEvents        FieldEvent[]
  syncAudits         SyncAuditLog[]
  queueReports       DeviceQueueReport[]
  simulatedNodes     SimulatedNode[]
  incidents          Incident[]
  invoiceLines       InvoiceLine[]
  damageCharges      DamageCharge[]
  serviceCredits     ServiceCredit[]
  lossCases          LossCase[]
  disposal           DeviceDisposal?
  dockSessions       DeviceDockSession[]
  hubActions         DeviceHubAction[]

  unitReleases UnitRelease[]

  @@index([status])
  @@index([hardwareVariantId, status])
  @@index([registeredById])
  @@map("devices")
}

// Why a dock session ended (specs/devices/design.md section 11.8).
enum DockEndReason {
  RELEASED // the connector released the port, the unit was unplugged or the tab closed
  EXPIRED // not renewed within devices.dockPresenceTtlSeconds (the devices.dockSweep job)
  REPLACED // another Staff browser opened a session for the same unit
}

// A Staff browser holding a unit's Web Serial port at the counter (design section 12.8, REQ-EVT-38). Only
// TrekLink callers see it, on the Staff live map; one open session per device (partial unique index on
// "deviceId" WHERE "endedAt" IS NULL, in the migration). Rows are kept as a record of who held which unit.
model DeviceDockSession {
  id         String         @id @default(uuid())
  deviceId   String
  device     Device         @relation(fields: [deviceId], references: [id])
  nodeNum    BigInt // the node number the browser read from the unit
  openedById String
  openedBy   User           @relation("DeviceDockSession_openedById", fields: [openedById], references: [id])
  openedAt   DateTime       @default(now()) @db.Timestamptz(3)
  renewedAt  DateTime       @db.Timestamptz(3)
  endedAt    DateTime?      @db.Timestamptz(3)
  endReason  DockEndReason?

  @@index([endedAt, renewedAt])
  @@map("device_dock_sessions")
}

// The device hub's actions on a docked unit (devices design section 12.14, api-design 33 and 34, leader UAT
// 2026-11-06): one row per action, STARTED before anything is written to the unit and SUCCEEDED or FAILED when it
// ends. Kept with the status and live contract at the start, since every status is allowed. Never deleted.
enum HubActionKind {
  REBOOT
  FACTORY_RESET
  RESTORE_DEFAULTS
  UPLINK
  FIRMWARE_UPDATE
}

enum HubActionOutcome {
  STARTED
  SUCCEEDED
  FAILED
}

model DeviceHubAction {
  id           String           @id @default(uuid())
  deviceId     String
  device       Device           @relation(fields: [deviceId], references: [id])
  action       HubActionKind
  outcome      HubActionOutcome @default(STARTED)
  nodeNum      BigInt // the docked unit's node number, checked against the device
  deviceStatus DeviceStatus // the status at the start
  contractId   String? // the live contract at the start, if any (rentals owns it; no foreign key across modules)
  contractCode String?
  firmwareFrom String? // FIRMWARE_UPDATE: the firmware on record at the start
  firmwareTo   String? // FIRMWARE_UPDATE: the release version written
  fullImage    Boolean          @default(false) // FIRMWARE_UPDATE: the factory image at 0x0 (NVS erased)
  failure      String? // FAILED: the step that failed
  actorId      String
  actor        User             @relation("DeviceHubAction_actorId", fields: [actorId], references: [id])
  startedAt    DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?        @db.Timestamptz(3)

  @@index([deviceId, startedAt])
  @@index([actorId])
  @@map("device_hub_actions")
}

model DeviceTransition {
  id         String        @id @default(uuid())
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id])
  fromStatus DeviceStatus? // null for the registration row
  toStatus   DeviceStatus
  actorId    String? // null = SYSTEM
  actor      User?         @relation(fields: [actorId], references: [id])
  reason     String // REGISTERED, INTAKE_PASSED, RESERVED, HANDED_OVER, CHECKED_IN, RETIRED, DISPOSED, ...
  note       String? // free text; for RETIRED, the Admin's retire reason (devices api-design 16)
  refType    String? // CONTRACT, INTAKE_CHECK, INSPECTION, MAINTENANCE
  refId      String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([actorId])
  @@map("device_transitions") // append-only trigger
}

// Intake check on registration and after maintenance (FR-DEV-03).
model IntakeCheck {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  gpsFixOk    Boolean
  radioOk     Boolean
  batteryOk   Boolean
  motionOk    Boolean? // null when the variant has no motion sensor
  passed      Boolean
  note        String?
  checkedById String
  checkedBy   User     @relation(fields: [checkedById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([checkedById])
  @@map("intake_checks") // append-only trigger
}

// The organization channel key written to a device at handover (FR-DEV-05). Version only.
model DeviceProvisioning {
  id              String       @id @default(uuid())
  deviceId        String
  device          Device       @relation(fields: [deviceId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  keyVersion      Int
  provisionedById String
  provisionedBy   User         @relation(fields: [provisionedById], references: [id])
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([organizationId])
  @@index([provisionedById])
  @@map("device_provisionings") // append-only trigger
}

// The logged reset on return (FR-DEV-07, BR-28).
model DeviceReset {
  id            String   @id @default(uuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id])
  keyRemoved    Boolean
  nodeDbCleared Boolean
  ownerCleared  Boolean
  resetById     String
  resetBy       User     @relation(fields: [resetById], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([deviceId, createdAt])
  @@index([resetById])
  @@map("device_resets") // append-only trigger
}

enum LossCaseState {
  REPORTED
  SEARCHING
  RECOVERED
  CONFIRMED
  SETTLED
}

enum LossCustody {
  RENTER // a custody interval of a contract contains the last seen time (D-040)
  TREKLINK
}

enum LossDecision {
  CHARGED
  REDUCED
  WAIVED
  WRITTEN_OFF // TrekLink custody: no charge
}

// One reported loss of a device (FR-DEV-12 to FR-DEV-15, D-045). At most one case per device
// outside RECOVERED and SETTLED: partial unique index in constraints.sql.
model LossCase {
  id               String          @id @default(uuid())
  code             String          @unique // LOSS-0001
  deviceId         String
  device           Device          @relation(fields: [deviceId], references: [id])
  state            LossCaseState   @default(REPORTED)
  stateFromDevice  DeviceStatus // the in-service state the device left when reported
  reportedById     String
  reportedBy       User            @relation("LossCase_reportedById", fields: [reportedById], references: [id])
  reportedAt       DateTime        @default(now()) @db.Timestamptz(3)
  description      String
  lastSeenAt       DateTime?       @db.Timestamptz(3) // from the device projection at report time
  lastLatitude     Float?
  lastLongitude    Float?
  // triage (FR-DEV-13)
  custody          LossCustody?
  contractDeviceId String? // the custody interval, for RENTER custody
  contractDevice   ContractDevice? @relation(fields: [contractDeviceId], references: [id])
  // The custody interval's contract and organization as CUSTODY_RESOLVER answered them (task 2.7):
  // `devices` cannot read the rentals tables, and billing needs the contract to charge. Set at report
  // from the custody at that time, replaced at triage by the custody at the last seen time.
  contractId       String?
  contract         RentalContract? @relation(fields: [contractId], references: [id])
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  keyExposed       Boolean         @default(false)
  suspectedTheft   Boolean         @default(false) // opens or links a compliance case (D-046)
  complianceCaseId String?
  complianceCase   ComplianceCase? @relation(fields: [complianceCaseId], references: [id])
  policeReference  String? // required on the compliance case for suspected theft or fraud
  triagedById      String?
  triagedBy        User?           @relation("LossCase_triagedById", fields: [triagedById], references: [id])
  triagedAt        DateTime?       @db.Timestamptz(3)
  searchEndsAt     DateTime?       @db.Timestamptz(3) // triagedAt + devices.lossSearchDays
  recoveredAt      DateTime?       @db.Timestamptz(3)
  confirmedAt      DateTime?       @db.Timestamptz(3)
  // settlement (FR-BILL-05, FR-BILL-11); the decider is never the triager (BR-39)
  decision         LossDecision?
  chargeVnd        Int? // remaining value charged, after any reduction
  decisionReason   String?
  decidedById      String?
  decidedBy        User?           @relation("LossCase_decidedById", fields: [decidedById], references: [id])
  settledAt        DateTime?       @db.Timestamptz(3)
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  @@index([deviceId, state])
  @@index([state, searchEndsAt])
  @@index([contractDeviceId])
  @@index([contractId])
  @@index([organizationId, state])
  @@index([complianceCaseId])
  @@index([reportedById])
  @@index([triagedById])
  @@index([decidedById])
  @@map("loss_cases")
}

// The verified wipe before disposal (FR-DEV-16, BR-42). One per device.
model DeviceDisposal {
  id            String   @id @default(uuid())
  deviceId      String   @unique
  device        Device   @relation(fields: [deviceId], references: [id])
  keyRemoved    Boolean
  nodeDbCleared Boolean
  ownerCleared  Boolean
  method        String // for example: sold for parts, recycled, destroyed
  verifiedById  String
  verifiedBy    User     @relation(fields: [verifiedById], references: [id])
  disposedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([verifiedById])
  @@map("device_disposals")
}

// Inspection after check-in and reset (UC-44). A DAMAGED result feeds billing (FR-BILL-04).
model Inspection {
  id               String           @id @default(uuid())
  deviceId         String
  device           Device           @relation(fields: [deviceId], references: [id])
  contractDeviceId String?
  contractDevice   ContractDevice?  @relation(fields: [contractDeviceId], references: [id])
  result           InspectionResult
  damageCodes      String[] // keys of DamageRate.code
  note             String?
  inspectorId      String
  inspector        User             @relation(fields: [inspectorId], references: [id])
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  damageCharges  DamageCharge[]
  serviceCredits ServiceCredit[]

  @@index([deviceId, createdAt])
  @@index([contractDeviceId])
  @@index([inspectorId])
  @@map("inspections") // append-only trigger
}

model MaintenanceRecord {
  id               String             @id @default(uuid())
  deviceId         String
  device           Device             @relation(fields: [deviceId], references: [id])
  reason           String // INTAKE_FAILED, INSPECTION_FAILED, HANDOVER_CHECK_FAILED, SCHEDULED, FIRMWARE_UPDATE, STAFF_REPORTED
  status           MaintenanceStatus  @default(OPEN)
  description      String
  expectedAt       DateTime           @db.Date // expected completion (FR-DEV-08)
  workBy           MaintenanceWorkBy?
  vendorName       String? // required when workBy is VENDOR
  estimatedCostVnd BigInt?
  estimatedById    String? // separation of duty: never the deciding Admin (BR-44)
  estimatedBy      User?              @relation("MaintenanceRecord_estimatedById", fields: [estimatedById], references: [id])
  approvedCostVnd  BigInt?
  decision         String? // APPROVED, REJECTED
  decisionReason   String?
  decidedById      String?
  decidedBy        User?              @relation("MaintenanceRecord_decidedById", fields: [decidedById], references: [id])
  decidedAt        DateTime?          @db.Timestamptz(3)
  actualCostVnd    BigInt?
  warrantyUntil    DateTime?          @db.Date
  checklistResults Json? // [{ "item": "Battery health", "passed": true, "note": "replaced" }], required for SCHEDULED
  firmwareVersion  String? // firmware on the unit after the work; required for FIRMWARE_UPDATE (FR-DEV-21)
  resolution       String?
  openedById       String? // null when the weekly scan opened it (SYSTEM)
  openedBy         User?              @relation("MaintenanceRecord_openedById", fields: [openedById], references: [id])
  closedById       String?
  closedBy         User?              @relation("MaintenanceRecord_closedById", fields: [closedById], references: [id])
  openedAt         DateTime           @default(now()) @db.Timestamptz(3)
  closedAt         DateTime?          @db.Timestamptz(3)
  version          Int                @default(0)

  @@index([deviceId, status])
  @@index([status])
  @@index([openedById])
  @@index([closedById])
  @@index([estimatedById])
  @@index([decidedById])
  @@map("maintenance_records")
}

// A stock-take run (FR-DEV-10): the scanned tags and the computed result, kept as evidence.
model StockTake {
  id          String   @id @default(uuid())
  scannedTags String[]
  result      Json // { inStockConfirmed, rentedSeen, unconfirmed: [assetTag] }
  takenById   String
  takenBy     User     @relation(fields: [takenById], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([takenById])
  @@map("stock_takes")
}

// @module rentals ──────────────────────────────────────────────────────────────────────────
// specs/rentals/design.md §1

enum PlanType {
  MONTHLY
  DAY
}

enum ContractStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  ENDING
  RETURN_DUE
  OVERDUE
  DEFAULTED
  RETURNED
  CLOSED
}

enum TermStatus {
  OPEN
  CLOSED
}

model RentalContract {
  id                    String          @id @default(uuid())
  code                  String          @unique // RC-2026-0042
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id])
  planType              PlanType
  dayPlanDays           Int? // 3, 4 or 7 for a day plan (rentals.dayPlanLengths)
  hardwareVariantId     String
  hardwareVariant       HardwareVariant @relation(fields: [hardwareVariantId], references: [id])
  quantity              Int
  requestedStartDate    DateTime        @db.Date
  // price snapshot at request time (FR-CFG-02: a price change applies only to later requests)
  monthlyUnitPriceVnd   BigInt
  dayPremium            Decimal?        @db.Decimal(5, 2)
  holdingFeeRatio       Decimal         @db.Decimal(4, 3)
  status                ContractStatus  @default(REQUESTED)
  statusChangedAt       DateTime        @default(now()) @db.Timestamptz(3)
  requestedById         String
  requestedBy           User            @relation("RentalContract_requestedById", fields: [requestedById], references: [id])
  decidedById           String?
  decidedBy             User?           @relation("RentalContract_decidedById", fields: [decidedById], references: [id])
  decidedAt             DateTime?       @db.Timestamptz(3)
  rejectionReason       String?
  reservationExpiresAt  DateTime?       @db.Timestamptz(3) // FR-CON-04
  handoverAppointmentAt DateTime?       @db.Timestamptz(3) // the counter appointment set at approval
  holdExpiresAt         DateTime?       @db.Timestamptz(3) // D-092 rule 1: an unpaid request hold ends here; null before D-092
  cancelledAt           DateTime?       @db.Timestamptz(3)
  cancelReason          String?
  // handover (FR-CON-05, FR-CON-06, D-037)
  handedOverAt          DateTime?       @db.Timestamptz(3)
  handedOverById        String?
  handedOverBy          User?           @relation("RentalContract_handedOverById", fields: [handedOverById], references: [id])
  identityChecked       String? // document type and last digits seen at the counter
  handoverNotePath      String? // stored PDF
  handoverNoteSha256    String?
  // end of contract
  endsAt                DateTime?       @db.Timestamptz(3) // day plan end, or the term end after notice
  noticeGivenAt         DateTime?       @db.Timestamptz(3)
  noticeGivenById       String?
  noticeGivenBy         User?           @relation("RentalContract_noticeGivenById", fields: [noticeGivenById], references: [id])
  returnDueAt           DateTime?       @db.Timestamptz(3)
  overdueAt             DateTime?       @db.Timestamptz(3)
  defaultedAt           DateTime?       @db.Timestamptz(3)
  returnedAt            DateTime?       @db.Timestamptz(3)
  closedAt              DateTime?       @db.Timestamptz(3)
  closedById            String?
  closedBy              User?           @relation("RentalContract_closedById", fields: [closedById], references: [id])
  version               Int             @default(0)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  terms              ContractTerm[]
  devices            ContractDevice[]
  transitions        ContractTransition[]
  invoices           Invoice[]
  damageCharges      DamageCharge[]
  serviceCredits     ServiceCredit[]
  payments           Payment[]
  incidents          Incident[]
  lossCases          LossCase[]
  authorityReports   AuthorityReport[]
  deviceFaultReports DeviceFaultReport[]

  unitReleases UnitRelease[] // D-099, rentals design §13

  @@index([organizationId, status])
  @@index([status, returnDueAt])
  // rentals REQ-EVT-26: the contract search matches a substring of the code ignoring case (ILIKE),
  // which a B-tree cannot serve; a trigram GIN index can (pg_trgm, created by its migration).
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "rental_contracts_code_trgm")
  @@index([hardwareVariantId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([handedOverById])
  @@index([noticeGivenById])
  @@index([closedById])
  @@map("rental_contracts")
}

// One monthly term; a day plan has exactly one term (SRS Table 74).
model ContractTerm {
  id         String         @id @default(uuid())
  contractId String
  contract   RentalContract @relation(fields: [contractId], references: [id])
  seq        Int // 1, 2, 3
  startsAt   DateTime       @db.Timestamptz(3)
  endsAt     DateTime       @db.Timestamptz(3)
  status     TermStatus     @default(OPEN)
  closedAt   DateTime?      @db.Timestamptz(3)
  invoice    Invoice?

  @@unique([contractId, seq])
  @@map("contract_terms") // CHECK endsAt > startsAt
}

// The exact signed bytes of a handover or replacement note, keyed by the stored note name the contract
// or device row records (rentals design §4.1, D-090 amendment): written only with
// HANDOVER_NOTE_STORE=database, for a host whose local disk does not outlive one request.
model HandoverNote {
  name      String   @id // "<contractId>.pdf", "<contractId>-replacement-<deviceId>.pdf"
  pdf       Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("handover_notes")
}

// A device committed to a contract (BR-03: at most one live row per device).
model ContractDevice {
  id                     String         @id @default(uuid())
  contractId             String
  contract               RentalContract @relation(fields: [contractId], references: [id])
  deviceId               String
  device                 Device         @relation(fields: [deviceId], references: [id])
  reservedAt             DateTime       @default(now()) @db.Timestamptz(3)
  releasedAt             DateTime?      @db.Timestamptz(3) // cancelled before handover, or swapped
  handedOverAt           DateTime?      @db.Timestamptz(3)
  checkedInAt            DateTime?      @db.Timestamptz(3)
  checkedInById          String?
  checkedInBy            User?          @relation("ContractDevice_checkedInById", fields: [checkedInById], references: [id])
  lostAt                 DateTime?      @db.Timestamptz(3)
  // optional holder label (FR-CON-14, BR-33); erased when the contract closes
  holderName             String?
  holderPhone            String?
  holderEmergencyContact String?

  // a replacement on a running contract (FR-CON-15, D-045): the row it replaces and its signed note
  replacesId            String?         @unique
  replaces              ContractDevice? @relation("ContractDevice_replaces", fields: [replacesId], references: [id])
  replacedBy            ContractDevice? @relation("ContractDevice_replaces")
  replacementNotePath   String?
  replacementNoteSha256 String?

  inspections      Inspection[]
  fieldEvents      FieldEvent[] // events attributed to this custody interval (D-040)
  lossCases        LossCase[]
  serviceCredits   ServiceCredit[]
  groupAssignments GroupAssignment[]
  faultReports     DeviceFaultReport[]

  unitReleases UnitRelease[]

  @@index([contractId])
  @@index([deviceId])
  @@index([checkedInById])
  @@map("contract_devices") // partial unique: one live row per device
}

enum GroupExit {
  MOVED
  UNASSIGNED
  GROUP_REMOVED
  CHECKED_IN
  LOST
  REPLACED
  RELEASED
}

enum FaultResolution {
  REPLACED
  CHECKED_IN
  LOST
  RELEASED
}

// An organization-owned group, retained for assignment history after removal (design §11.2).
model Group {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  parentId       String?
  parent         Group?            @relation("GroupTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children       Group[]           @relation("GroupTree")
  name           String
  label          String?
  startsOn       DateTime?         @db.Date
  endsOn         DateTime?         @db.Date
  areaNote       String?
  version        Int               @default(1)
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  removedAt      DateTime?         @db.Timestamptz(3)
  assignments    GroupAssignment[]

  @@unique([organizationId, id])
  @@index([parentId, organizationId])
  @@index([createdById])
  @@map("groups") // live sibling names and date ordering are enforced in constraints.sql
}

model GroupAssignment {
  id               String         @id @default(uuid())
  groupId          String
  group            Group          @relation(fields: [groupId], references: [id])
  deviceId         String
  device           Device         @relation(fields: [deviceId], references: [id])
  contractDeviceId String
  contractDevice   ContractDevice @relation(fields: [contractDeviceId], references: [id])
  assignedById     String
  assignedBy       User           @relation(fields: [assignedById], references: [id])
  assignedAt       DateTime       @default(now()) @db.Timestamptz(3)
  endedAt          DateTime?      @db.Timestamptz(3)
  endedReason      GroupExit?

  @@index([groupId])
  @@index([deviceId])
  @@index([contractDeviceId])
  @@index([assignedById])
  @@map("group_assignments") // partial unique: one open assignment per device
}

model DeviceFaultReport {
  id               String           @id @default(uuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  contractId       String
  contract         RentalContract   @relation(fields: [contractId], references: [id])
  contractDeviceId String
  contractDevice   ContractDevice   @relation(fields: [contractDeviceId], references: [id])
  deviceId         String
  device           Device           @relation(fields: [deviceId], references: [id])
  description      String
  reportedById     String
  reportedBy       User             @relation(fields: [reportedById], references: [id])
  reportedAt       DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt       DateTime?        @db.Timestamptz(3)
  resolution       FaultResolution?
  serviceCredits   ServiceCredit[]

  @@index([organizationId])
  @@index([contractId])
  @@index([contractDeviceId])
  @@index([deviceId])
  @@index([reportedById])
  @@map("device_fault_reports") // partial unique: one open report per custody row
}

model ContractTransition {
  id         String          @id @default(uuid())
  contractId String
  contract   RentalContract  @relation(fields: [contractId], references: [id])
  fromStatus ContractStatus?
  toStatus   ContractStatus
  actorId    String? // null = SYSTEM
  actor      User?           @relation(fields: [actorId], references: [id])
  reason     String?
  refType    String?
  refId      String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([contractId, createdAt])
  @@index([actorId])
  @@map("contract_transitions") // append-only trigger
}

// rentals design §13 (D-099): whether the released unit had been handed over.
enum ReleasePhase {
  BEFORE_HANDOVER
  RUNNING
}

// One unit given back before the term end (rentals design §13, D-099); the contract's release history.
model UnitRelease {
  id               String         @id @default(uuid())
  contractId       String
  contract         RentalContract @relation(fields: [contractId], references: [id])
  contractDeviceId String
  contractDevice   ContractDevice @relation(fields: [contractDeviceId], references: [id])
  deviceId         String
  device           Device         @relation(fields: [deviceId], references: [id])
  phase            ReleasePhase
  reason           String
  releasedById     String
  releasedBy       User           @relation("UnitRelease_releasedById", fields: [releasedById], references: [id])
  releasedAt       DateTime       @db.Timestamptz(3)
  quantityBefore   Int
  quantityAfter    Int
  serviceCredit    ServiceCredit?

  @@index([contractId])
  @@index([contractDeviceId])
  @@index([deviceId])
  @@index([releasedById])
  @@map("unit_releases")
}

// @module billing ──────────────────────────────────────────────────────────────────────────
// specs/billing/design.md §1

enum InvoiceKind {
  TERM // a monthly term: holding fee line and balance line
  DAY_PLAN
  CLOSING // late, damage and loss charges at the end of the contract
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CREDIT_DUE // total below zero: TrekLink owes the organization (billing design section 11, D-097 amended)
  REFUNDED // the credit due was refunded outside TrekLink and recorded
}

enum InvoiceLineType {
  HOLDING_FEE
  TERM_BALANCE
  DAY_PLAN_FEE
  LATE_FEE
  DAMAGE
  LOSS
  ADJUSTMENT
  SERVICE_CREDIT // negative: a unit that failed through no fault of the organization (design §9)
  EARLY_END_CREDIT // negative: the unused whole days of a term ended now (D-097, design §10)
}

// Why a unit failed through no fault of the organization (billing design §9.1, D-092 rule 5).
// billing design §12.1 (D-099): what a service credit is for.
enum ServiceCreditKind {
  FAULT
  RELEASE
}

enum ServiceCreditCause {
  BATTERY_FAULT
  RADIO_FAULT
  GPS_FAULT
  BOARD_FAULT
  FIRMWARE_FAULT
}

// billing design §9.3. APPLIED once the whole decided amount is on invoices; a remainder keeps it
// APPROVED until it lands, or the close turns it into REFUND_DUE.
enum ServiceCreditStatus {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
  REFUND_DUE
  REFUNDED
}

enum PaymentMethod {
  SEPAY
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING // SePay request created, waiting for the webhook
  CONFIRMED
  FAILED
  EXPIRED
}

enum DamageChargeStatus {
  PENDING_APPROVAL
  APPROVED
  REDUCED
  WAIVED
}

// Monthly price per device by variant, effective from a time (UC-56). Append-only; the latest
// row with effectiveFrom <= now is current.
model PriceSchedule {
  id                String          @id @default(uuid())
  hardwareVariantId String
  hardwareVariant   HardwareVariant @relation(fields: [hardwareVariantId], references: [id])
  monthlyPriceVnd   BigInt
  effectiveFrom     DateTime        @db.Timestamptz(3)
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([hardwareVariantId, effectiveFrom])
  @@index([createdById])
  @@map("price_schedules") // append-only trigger
}

// The damage schedule (FR-BILL-04): a fixed amount per damage code, optionally per variant.
model DamageRate {
  id                String           @id @default(uuid())
  code              String // CASING_CRACKED, ANTENNA_BROKEN, ...
  label             String
  hardwareVariantId String?
  hardwareVariant   HardwareVariant? @relation(fields: [hardwareVariantId], references: [id])
  amountVnd         BigInt
  isActive          Boolean          @default(true)
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([code, hardwareVariantId]) // a NULL variant is covered by damage_rates_one_global_code (constraints.sql)
  @@index([hardwareVariantId])
  @@index([createdById])
  @@map("damage_rates")
}

// Immutable once issued (FR-BILL-06); corrections are ADJUSTMENT lines on the closing invoice.
model Invoice {
  id             String         @id @default(uuid())
  number         String         @unique // INV-2026-000123
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  contractId     String
  contract       RentalContract @relation(fields: [contractId], references: [id])
  termId         String?        @unique
  term           ContractTerm?  @relation(fields: [termId], references: [id])
  kind           InvoiceKind
  status         InvoiceStatus  @default(ISSUED)
  totalVnd       BigInt
  paidVnd        BigInt         @default(0)
  issuedAt       DateTime       @default(now()) @db.Timestamptz(3)
  // The refund of a credit due, made outside TrekLink (design section 11, D-097 amended); all four or none.
  refundedVnd    BigInt?
  refundedAt     DateTime?      @db.Timestamptz(3)
  refundedById   String?
  refundedBy     User?          @relation("Invoice_refundedById", fields: [refundedById], references: [id])
  refundNote     String?        @db.VarChar(500)

  lines    InvoiceLine[]
  payments Payment[]

  @@index([organizationId, status])
  @@index([contractId])
  @@map("invoices")
}

model InvoiceLine {
  id              String          @id @default(uuid())
  invoiceId       String
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  seq             Int
  type            InvoiceLineType
  description     String
  deviceId        String?
  device          Device?         @relation(fields: [deviceId], references: [id])
  quantity        Int             @default(1)
  unitVnd         BigInt
  amountVnd       BigInt
  dueAt           DateTime        @db.Timestamptz(3)
  paidVnd         BigInt          @default(0)
  createdById     String?
  createdBy       User?           @relation("InvoiceLine_createdById", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  // A SERVICE_CREDIT line names its credit; a credit larger than one invoice lands as several lines
  // (design §9.3, build ruling 2026-11-02).
  serviceCreditId String?
  serviceCredit   ServiceCredit?  @relation(fields: [serviceCreditId], references: [id])

  @@unique([invoiceId, seq])
  @@index([deviceId])
  @@index([createdById])
  @@index([dueAt])
  @@index([serviceCreditId])
  @@map("invoice_lines")
}

// One payment against an invoice. `reference` is unique: a repeated webhook or a repeated counter
// entry records nothing (FR-BILL-08, BR-31).
model Payment {
  id             String         @id @default(uuid())
  reference      String         @unique // TL<base32>, issued by the system for SePay; receipt number at the counter
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  contractId     String
  contract       RentalContract @relation(fields: [contractId], references: [id])
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id])
  amountVnd      BigInt
  method         PaymentMethod
  status         PaymentStatus
  isSandbox      Boolean        @default(true) // BR-34
  gatewayTxnId   String?        @unique // SePay transaction id from the webhook
  gatewayPayload Json?
  failureReason  String?
  requestedById  String?
  requestedBy    User?          @relation("Payment_requestedById", fields: [requestedById], references: [id])
  recordedById   String? // Staff for a counter payment
  recordedBy     User?          @relation("Payment_recordedById", fields: [recordedById], references: [id])
  expiresAt      DateTime?      @db.Timestamptz(3)
  confirmedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([contractId])
  @@index([invoiceId])
  @@index([requestedById])
  @@index([recordedById])
  @@map("payments")
}

// A damage charge from an inspection, held for approval above the threshold (FR-BILL-04, BR-24).
model DamageCharge {
  id           String             @id @default(uuid())
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id])
  deviceId     String
  device       Device             @relation(fields: [deviceId], references: [id])
  // D-081: the contract and the inspector, written by `chargeDamage`, so the decision (UC-48) checks
  // SEPARATION_OF_DUTY and finds the closing invoice from billing's own table.
  contractId   String
  contract     RentalContract     @relation(fields: [contractId], references: [id])
  inspectorId  String
  inspector    User               @relation("DamageCharge_inspectorId", fields: [inspectorId], references: [id])
  // The codes priced into this charge, as the inspection recorded them; the Admin queue reads them
  // without a read from `devices`.
  damageCodes  String[]
  amountVnd    BigInt // from the damage schedule
  finalVnd     BigInt? // after approval, reduction or waiver
  status       DamageChargeStatus
  decidedById  String?
  decidedBy    User?              @relation("DamageCharge_decidedById", fields: [decidedById], references: [id])
  decisionNote String?
  decidedAt    DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  @@index([inspectionId])
  @@index([deviceId])
  @@index([contractId])
  @@index([inspectorId])
  @@index([decidedById])
  @@index([status])
  @@map("damage_charges")
}

// A credit for a unit of a contract that failed through no fault of the organization (billing task
// 8.1, design §9, D-092 rule 5). Staff request it after the unit is checked in or replaced; an Admin
// who did not request it decides; the decided amount lands as negative SERVICE_CREDIT lines.
model ServiceCredit {
  id                        String              @id @default(uuid())
  contractId                String
  contract                  RentalContract      @relation(fields: [contractId], references: [id])
  organizationId            String // copied from the contract, for the own-organization reads
  organization              Organization        @relation(fields: [organizationId], references: [id])
  contractDeviceId          String // the unit's row on the contract
  contractDevice            ContractDevice      @relation(fields: [contractDeviceId], references: [id])
  deviceId                  String
  device                    Device              @relation(fields: [deviceId], references: [id])
  // FAULT (design §9) or RELEASE (design §12.1, D-099); a RELEASE credit has no fault fields, and two
  // CHECKs in its migration keep them required on FAULT rows
  kind                      ServiceCreditKind   @default(FAULT)
  unitReleaseId             String?             @unique
  unitRelease               UnitRelease?        @relation(fields: [unitReleaseId], references: [id], onDelete: Restrict)
  cause                     ServiceCreditCause?
  faultInspectionId         String? // the FAILED inspection of that row (design §9.1)
  faultInspection           Inspection?         @relation(fields: [faultInspectionId], references: [id], onDelete: Restrict)
  outageFrom                DateTime?           @db.Timestamptz(3)
  // the source of outageFrom, one required (leader ruling 2026-11-02)
  outageSourceIncidentId    String?
  outageSourceIncident      Incident?           @relation(fields: [outageSourceIncidentId], references: [id])
  outageSourceFaultReportId String?
  outageSourceFaultReport   DeviceFaultReport?  @relation(fields: [outageSourceFaultReportId], references: [id], onDelete: Restrict)
  outageSourceNote          String?
  outageTo                  DateTime?           @db.Timestamptz(3) // computed (design §9.2)
  outageDays                Int?
  computedVnd               BigInt
  decidedVnd                BigInt?
  appliedVnd                BigInt              @default(0) // sum of its SERVICE_CREDIT lines, as a positive amount
  status                    ServiceCreditStatus
  requestedById             String
  requestedBy               User                @relation("ServiceCredit_requestedById", fields: [requestedById], references: [id])
  decidedById               String?
  decidedBy                 User?               @relation("ServiceCredit_decidedById", fields: [decidedById], references: [id])
  decisionReason            String?
  decidedAt                 DateTime?           @db.Timestamptz(3)
  refundReference           String?             @unique
  refundedAt                DateTime?           @db.Timestamptz(3)
  version                   Int                 @default(1)
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(3)
  lines                     InvoiceLine[]

  @@index([contractId])
  @@index([organizationId])
  @@index([contractDeviceId])
  @@index([deviceId])
  @@index([faultInspectionId])
  @@index([outageSourceIncidentId])
  @@index([outageSourceFaultReportId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([status])
  @@map("service_credits")
}

// @module incidents ────────────────────────────────────────────────────────────────────────
// specs/incidents/design.md §1, D-034

enum IncidentState {
  DETECTED
  NOTIFY_PRIMARY
  NOTIFY_BACKUP
  NOTIFY_MANAGER
  UNROUTED
  ESCALATED
  REPORTED
  ACKNOWLEDGED
  RESPONDING
  RESOLVED
  FALSE_ALARM
  CLOSED
}

enum IncidentSource {
  DEVICE_SOS
  DEVICE_FALL
  CADENCE_INFERRED
}

enum IncidentConfidence {
  CONFIRMED
  SUSPECTED
}

enum AlertChannel {
  WEB
  WEBSOCKET
  EMAIL
  API_EVENT
}

// TRANSITION: written with a transition (MSG31, MSG34). STALE: the device-silent flag was set
// (REQ-EVT-12, MSG40); it has no transition.
enum AlertKind {
  TRANSITION
  STALE
}

enum AlertStatus {
  PENDING
  SENT
  FAILED // retries exhausted
}

model Incident {
  id                 String             @id @default(uuid())
  code               String             @unique // INC-2026-000045
  deviceId           String
  device             Device             @relation(fields: [deviceId], references: [id])
  // routing, fixed at creation (FR-INC-03); null when UNROUTED
  contractId         String?
  contract           RentalContract?    @relation(fields: [contractId], references: [id])
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  state              IncidentState      @default(DETECTED)
  stateChangedAt     DateTime           @default(now()) @db.Timestamptz(3)
  source             IncidentSource
  confidence         IncidentConfidence
  openedByEventId    String?            @unique
  openedByEvent      FieldEvent?        @relation("Incident_openedByEventId", fields: [openedByEventId], references: [eventId])
  firstEventAt       DateTime           @db.Timestamptz(3)
  lastEventAt        DateTime           @db.Timestamptz(3) // correlation window anchor
  eventCount         Int                @default(1)
  lastLatitude       Float?
  lastLongitude      Float?
  lastPositionAt     DateTime?          @db.Timestamptz(3) // fix time of the last position; an older fix never overwrites it
  // owner and timers (NFR-REL-07: every non-terminal state has an owner or a pending deadline)
  ownerId            String?
  owner              User?              @relation("Incident_ownerId", fields: [ownerId], references: [id])
  tierDeadlineAt     DateTime?          @db.Timestamptz(3) // NOTIFY_* acknowledge timeout
  statusDueAt        DateTime?          @db.Timestamptz(3) // ACKNOWLEDGED / RESPONDING stale limit
  reopenWindowEndsAt DateTime?          @db.Timestamptz(3) // RESOLVED / FALSE_ALARM
  stale              Boolean            @default(false) // device silent during the incident (FR-INC-13)
  acknowledgedAt     DateTime?          @db.Timestamptz(3) // time-to-acknowledge basis
  resolvedAt         DateTime?          @db.Timestamptz(3) // time-to-resolve basis
  outcomeNote        String?
  falseAlarmReason   String?
  reopenCount        Int                @default(0)
  closedAt           DateTime?          @db.Timestamptz(3)
  simulated          Boolean            @default(false) // opened by a simulated field event (demo design §9)
  version            Int                @default(0) // compare-and-set (D-034 rule 1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  transitions      IncidentTransition[]
  alerts           AlertDelivery[]
  statusUpdates    IncidentStatusUpdate[]
  authorityReports AuthorityReport[]
  events           FieldEvent[]           @relation("FieldEvent_incidentId")
  serviceCredits   ServiceCredit[] // credits whose outage start this incident reported

  @@index([deviceId, state, lastEventAt]) // correlation lookup
  @@index([organizationId, state])
  @@index([contractId])
  @@index([state, tierDeadlineAt])
  @@index([state, statusDueAt])
  @@index([state, reopenWindowEndsAt])
  @@index([ownerId])
  @@map("incidents")
}

model IncidentTransition {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  seq        Int // 1, 2, 3 per incident
  fromState  IncidentState?
  toState    IncidentState
  actorId    String? // null = SYSTEM
  actor      User?          @relation(fields: [actorId], references: [id])
  reason     String // CREATED, ROUTED, TIER_TIMEOUT, ACKNOWLEDGED, STALE_LIMIT, ...
  note       String?
  refEventId String?
  refEvent   FieldEvent?    @relation("IncidentTransition_refEventId", fields: [refEventId], references: [eventId])
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  alerts AlertDelivery[]

  @@unique([incidentId, seq])
  @@index([actorId])
  @@index([refEventId])
  @@map("incident_transitions") // append-only trigger
}

// Status reports during a response (UC-33). Append-only.
model IncidentStatusUpdate {
  id          String                @id @default(uuid())
  incidentId  String
  incident    Incident              @relation(fields: [incidentId], references: [id])
  authorId    String
  author      User                  @relation(fields: [authorId], references: [id])
  note        String
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  // A correction is a new row naming the update it corrects; the corrected row is never edited
  // (dry run defect 15). Unique, so an update is corrected at most once; a correction can itself
  // be corrected by a later row.
  correctsId  String?               @unique
  corrects    IncidentStatusUpdate? @relation("IncidentStatusUpdate_corrects", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy IncidentStatusUpdate? @relation("IncidentStatusUpdate_corrects")

  @@index([incidentId, createdAt])
  @@index([authorId])
  @@map("incident_status_updates") // append-only trigger
}

// Outbox row written in the transition's transaction, delivered after commit (D-034 rule 3). A STALE
// row is written in the transaction that sets the device-silent flag instead, with no transition and
// the device's last reading in `lastSeenAt`; a CHECK constraint keeps the two kinds apart.
model AlertDelivery {
  id            String              @id @default(uuid())
  incidentId    String
  incident      Incident            @relation(fields: [incidentId], references: [id])
  kind          AlertKind           @default(TRANSITION)
  transitionId  String?
  transition    IncidentTransition? @relation(fields: [transitionId], references: [id], onDelete: Restrict)
  lastSeenAt    DateTime?           @db.Timestamptz(3)
  tier          String // PRIMARY, BACKUP, MANAGER, TREKLINK, OWNER
  recipientId   String? // null for an API_EVENT to the organization's stream
  recipient     User?               @relation(fields: [recipientId], references: [id])
  channel       AlertChannel
  status        AlertStatus         @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @db.Timestamptz(3)
  lastError     String?
  sentAt        DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([incidentId])
  @@index([transitionId])
  @@index([recipientId])
  @@map("alert_deliveries")
}

// A report to the authorities (FR-INC-10, BR-17): on an ESCALATED or UNROUTED incident, or on a
// DEFAULTED contract.
model AuthorityReport {
  id             String          @id @default(uuid())
  incidentId     String?
  incident       Incident?       @relation(fields: [incidentId], references: [id])
  contractId     String?
  contract       RentalContract? @relation(fields: [contractId], references: [id])
  agency         String
  reference      String
  reportedAt     DateTime        @db.Timestamptz(3)
  reportedById   String
  reportedBy     User            @relation("AuthorityReport_reportedById", fields: [reportedById], references: [id])
  note           String?
  caseClosedAt   DateTime?       @db.Timestamptz(3)
  caseClosedById String?
  caseClosedBy   User?           @relation("AuthorityReport_caseClosedById", fields: [caseClosedById], references: [id])
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([incidentId])
  @@index([contractId])
  @@index([reportedById])
  @@index([caseClosedById])
  @@map("authority_reports") // CHECK exactly one of incidentId, contractId
}

// @module gateway-sync ─────────────────────────────────────────────────────────────────────
// specs/gateway-sync/design.md §1

enum PriorityTier {
  P0_SOS
  P1_LOCATION
  P2_GPS
  P3_TELEMETRY
}

enum EventKind {
  SOS
  FALL_SOS
  POSITION
  TELEMETRY
  CHAT
}

// Where FieldEvent.occurredAt came from, in order of preference (FR-EVT-15, D-040).
enum TimeSource {
  STATION_CORRECTED // Field Station capture time plus the offset receivedAt - fs_sent_at
  DEVICE_RTC // device rx_time, non-zero and plausible
  SERVER_RECEIPT // receivedAt, the upper bound
}

enum AttributionState {
  ATTRIBUTED // inside one ContractDevice custody interval (FR-EVT-16)
  UNATTRIBUTED // no interval, organization mismatch, or too close to a handover (FR-EVT-17)
}

enum IngressPath {
  MQTT_NODE // Stage A and B: the node's own uplink
  FIELD_STATION // Stage C
}

enum SyncOutcome {
  ACCEPTED
  DUPLICATE_REJECTED
  MALFORMED_ENVELOPE
  NORMALIZATION_FAILED
  UNKNOWN_DEVICE
  NOT_RENTED_TO_STATION_ORG // FR-EVT-14: the station's organization neither holds the device nor returned it within the late-upload grace
  INVALID_POSITION
  IMPLAUSIBLE_POSITION // FR-MON-04: persisted, not projected, not plotted
  QUEUE_REPORT // Stage B health packet, no FieldEvent
  ACCEPTED_UNATTRIBUTED // FR-EVT-17, BR-36: persisted with no organization; Staff and Admin only
}

// Append-only ledger of accepted field events and the telemetry history.
model FieldEvent {
  id               String           @id @default(uuid())
  seq              BigInt           @unique @default(autoincrement()) // ingestion order
  eventId          String           @unique // sha256(nodeNum:packetId), D-006
  deviceId         String
  device           Device           @relation(fields: [deviceId], references: [id])
  // the organization of the custody interval the event is attributed to; null when UNATTRIBUTED.
  // Never the device's current holder (FR-EVT-16, BR-36, D-040)
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  contractDeviceId String? // the custody interval; null when UNATTRIBUTED
  contractDevice   ContractDevice?  @relation(fields: [contractDeviceId], references: [id])
  attribution      AttributionState
  fieldStationId   String?
  fieldStation     FieldStation?    @relation(fields: [fieldStationId], references: [id])
  uplinkKey        String // node id or Field Station MQTT username
  ingress          IngressPath
  kind             EventKind
  priority         PriorityTier
  observedAt       DateTime?        @db.Timestamptz(3) // device rx_time; null when 0 (FR-EVT-08)
  capturedAt       DateTime?        @db.Timestamptz(3) // Stage C: fs_captured_at, station clock, uncorrected
  occurredAt       DateTime         @db.Timestamptz(3) // custody attribution (D-040); episode trail order for API 13 (issue #118); sync ledger orders by seq
  timeSource       TimeSource
  receivedAt       DateTime         @default(now()) @db.Timestamptz(3)
  latitude         Float?
  longitude        Float?
  altitude         Float?
  batteryPct       Int?
  rssi             Int?
  snr              Float?
  hopsAway         Int?
  plotted          Boolean          @default(true) // false for IMPLAUSIBLE_POSITION
  simulated        Boolean          @default(false) // ingested by the field simulation (demo design §9), never by MQTT or a Field Station
  payload          Json // raw payload, persisted verbatim
  incidentId       String? // set when this event opened or joined an episode
  incident         Incident?        @relation("FieldEvent_incidentId", fields: [incidentId], references: [id])

  openedIncident        Incident?            @relation("Incident_openedByEventId")
  transitionsAsRefEvent IncidentTransition[] @relation("IncidentTransition_refEventId")

  @@index([deviceId, receivedAt])
  @@index([deviceId, occurredAt]) // device history range (monitoring api-design 03)
  @@index([deviceId, kind, receivedAt])
  @@index([organizationId, seq])
  @@index([contractDeviceId])
  @@index([attribution, seq])
  @@index([incidentId])
  @@index([fieldStationId])
  @@map("field_events") // append-only trigger, one-way incidentId link allowed
}

// Every ingestion attempt, accepted or not: the evidence base for RQ1 (FR-EVT-11).
model SyncAuditLog {
  id         String      @id @default(uuid())
  eventId    String?
  nodeNum    BigInt?
  deviceId   String?
  device     Device?     @relation(fields: [deviceId], references: [id])
  uplinkKey  String?
  ingress    IngressPath
  outcome    SyncOutcome
  detail     String?
  rawMessage Json?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([outcome, createdAt])
  // The audit list pages by createdAt then id, newest first (SyncQueryRepository.pageAudit); a backward
  // scan of this index serves that ORDER BY (review of #235).
  @@index([createdAt, id])
  @@index([eventId])
  @@index([deviceId])
  @@map("sync_audit_log") // append-only trigger
}

// Stage B on-device queue health (NFR-IF-01).
model DeviceQueueReport {
  id               String   @id @default(uuid())
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id])
  schemaVersion    Int
  uptimeSeconds    Int
  capacity         Int
  depth            Int[] // index 0 = P0 .. 3 = P3
  enqueued         Int[]
  published        Int[]
  shed             Int[]
  p0Refused        Int
  flashWriteFailed Int
  restoreDiscarded Int
  rebootDetected   Boolean  @default(false)
  receivedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([deviceId, receivedAt])
  @@map("device_queue_reports")
}

enum SimulationPattern {
  WALK // along the trail at the node's speed, turning back at either end
  STOP // stays where it is
  STRAY // 300 m to one side of the trail over ten minutes, then stays
  SILENT // sends nothing
  LOW_BATTERY // walks while the battery falls 2 points a minute to 5
}

// How a simulated node moves while its pattern walks (specs/demo/design.md section 9.1, leader ruling
// 2026-11-06).
enum SimulationStyle {
  JOGGER // steady fast pace along the trail
  HIKER // fast pace, breaks, a circle round the spot
  CAMPER // to a camp, stays, returns
  EXPLORER // smooth random walk within about 300 m
  TRAIL_WALKER // along the trail at its own pace, with rest stops
  WANDERER // slow random walk round a camp or viewpoint
  GROUP_FOLLOWER // behind the trail's lead guide
  STRAGGLER // still at camp, or lagging and drifting off the trail; radio shadows
}

enum SimulatedNodeStatus {
  RUNNING
  STOPPED
}

enum SimulatedSosKind {
  SOS
  FALL
}

// A device driven by the field simulation (specs/demo/design.md §9, D-093 amendment). The position at a
// time is derived from the anchor and the elapsed time under the pattern, so every run computes the same
// packets. At most one RUNNING row per device: partial unique index simulated_nodes_one_running_per_device
// in migration 20261102120000_simulation.
model SimulatedNode {
  id                   String              @id @default(uuid())
  deviceId             String
  device               Device              @relation(fields: [deviceId], references: [id])
  nodeNum              BigInt // the device's radio identity when started, for the packets' `from`
  trailId              String // an id of simulator/trails.ts
  pattern              SimulationPattern
  style                SimulationStyle? // null: a node started before the styles, the steady walk
  styleSeed            Int                 @default(0) // FNV-1a of the asset tag (design section 9.1)
  speedMetresPerMinute Int                 @default(60)
  anchorAt             DateTime            @db.Timestamptz(3)
  anchorMetres         Float // distance along the trail at the anchor
  anchorLat            Float
  anchorLon            Float
  anchorBattery        Float
  direction            Int // 1 toward the trail's end, -1 toward its start
  strayBearing         Float? // degrees, null unless STRAY
  sosKind              SimulatedSosKind?
  sosSince             DateTime?           @db.Timestamptz(3)
  beaconedUntil        DateTime?           @db.Timestamptz(3) // time of the last beacon ingested
  status               SimulatedNodeStatus @default(RUNNING)
  version              Int                 @default(0)
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  @@index([deviceId])
  @@index([status, updatedAt])
  @@index([createdById])
  @@map("simulated_nodes")
}

// @module monitoring ───────────────────────────────────────────────────────────────────────
// specs/monitoring/design.md §1

// The organization-scoped live stream, replayable from a cursor (FR-MON-05, FR-MON-06).
// organizationId null = a platform-wide entry visible to TrekLink Staff and Admin only.
model StreamEvent {
  seq            BigInt        @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type           String // device.position, device.telemetry, device.stale, incident.changed, station.stale
  deviceId       String?
  payload        Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([organizationId, seq])
  @@index([createdAt])
  @@map("stream_events") // pruned after monitoring.streamRetentionHours
}

// The latest check-in of a device from an organization, one row per pair, replaced on each check-in.
// A field event is accepted late for gatewaySync.lateUploadGraceHours (168), longer than the stream is
// kept (monitoring.streamRetentionHours, 72), so the boundary that marks a late upload cannot live in the
// pruned stream (REQ-EVT-04, AC-06). Plain ids, as on StreamEvent.deviceId: a boundary outlives neither
// an organization nor a device and needs no foreign key.
model DeviceRelease {
  organizationId String
  deviceId       String
  checkedInAt    DateTime @db.Timestamptz(3)

  @@id([organizationId, deviceId])
  @@map("device_releases")
}

enum StaleSubject {
  DEVICE
  FIELD_STATION
}

// What the staleness sweep last reported stale (task 2.4, design §1 and §3): one row per device or Field
// Station it reported stale, deleted when it reports the recovery. Stored, so the sweep emits a
// transition once and a restart repeats none. `organizationId` is the organization the stale entry went
// to (the device's holder, the station's owner), so a device handed to another organization while stale
// is reconsidered for the new one and the old one hears nothing more (REQ-EVT-04). `lastSeenAt` is the
// last-seen time the stale entry carried; a later one means the subject was heard again. Plain ids, as
// on DeviceRelease.
model StaleMark {
  subjectType    StaleSubject
  subjectId      String
  organizationId String?
  lastSeenAt     DateTime     @db.Timestamptz(3)
  markedAt       DateTime     @db.Timestamptz(3)

  @@id([subjectType, subjectId])
  @@map("stale_marks")
}

// @module demo
// W43: durable demo provenance and a restart-safe escalation profile. No business rows are owned here.
model DemoScenarioRun {
  id        Int      @id @default(autoincrement())
  actorId   String
  action    String
  records   Json     @default("[]")
  error     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("demo_scenario_runs")
}

model DemoControlState {
  id       String @id
  version  Int    @default(0)
  snapshot Json?
  @@map("demo_control_states")
}
