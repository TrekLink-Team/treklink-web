# Environment of the AWS field host (specs/platform/design.md §2.5, D-098, deploy/aws/RUNBOOK.md).
# Copy to deploy/aws/.env on the host only and fill in the values there; the file is git-ignored and
# never committed. Docker Compose reads it twice: for the ${...} values of compose.yml, and as the
# backend's environment (env_file). No value below is real.
#
# Set in compose.yml, not here, because they define the host's mode and must not follow a copied Vercel
# value: NODE_ENV=production, PORT_BACKEND=3000, MQTT_BROKER_URL=mqtt://mosquitto:1883,
# MQTT_INGESTION_ENABLED=true, JOBS_TICK_ON_REQUEST=false, FIELD_SIMULATOR_ENABLED=false,
# DEMO_CONTROLS_ENABLED=false, DEMO_TEST_ACCOUNTS_ENABLED=false, DEMO_SIMULATION_ENABLED=false,
# SWAGGER_ENABLED=false, HANDOVER_NOTE_STORE=database.

# ---- Certificate and Compose ----
# The host name of the certificate and of every field client's broker address, an A record to the
# host's static IP (for example mqtt.<your domain>).
MQTT_DOMAIN=
# The address Let's Encrypt writes to about the certificate (expiry warnings).
ACME_EMAIL=
# Optional: seconds between the broker's checks for a renewed certificate (default 3600).
# CERT_CHECK_SECONDS=3600
# Optional: the tag of the backend image compose builds (default field), for example the staging commit.
# BACKEND_TAG=

# ---- Database: the Neon database of the Vercel production ----
# Both strings point at treklink_prod on the Neon branch vercel-prod, the database the Vercel staging
# reads; copy them from the Vercel project's Production environment. The container NEVER runs
# `prisma migrate` or a seed against them: the Vercel production build migrates and seeds
# (backend/scripts/vercel-build.sh). DATABASE_DIRECT_URL is required at start by the validation only.
# DATABASE_URL is the pooled string (host contains -pooler).
DATABASE_URL=
DATABASE_DIRECT_URL=

# ---- Broker (gateway-sync design §4) ----
# The secret broker-hook-proxy adds to every go-auth call and the backend checks: hexadecimal, at least
# 16 characters (openssl rand -hex 32). Shared by the proxy and the backend on this host only.
MQTT_AUTH_HOOK_SECRET=
# The backend subscriber's own credential; the hooks accept it and it may only subscribe and read.
MQTT_USERNAME=treklink-backend
MQTT_PASSWORD=
# The password every Wi-Fi node (username node-<nodeId>) and its phone proxy present, at least 16
# characters; Staff type it in the docking form. Unset, every fleet node is refused.
MQTT_NODE_PASSWORD=
# The topic root (default treklink, frozen by D-005) and the subscriber's client id, which keys its
# persistent session on this broker.
# MQTT_ROOT=treklink
# MQTT_CLIENT_ID_BACKEND=treklink-backend-aws

# ---- The same values as the Vercel production ----
# The host's scheduled jobs and the Vercel request tick share the database (design §4.6, advisory lock per
# job), so either may send an email alert or a staff notification: mail and letterhead must match.
# NODE_ENV=production refuses the console mail transport and the placeholder tax code and hotline.
MAIL_TRANSPORT=smtp
SMTP_URL=
MAIL_FROM=
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_CODE=
COMPANY_HOTLINE=
HANDOVER_PLACE=
# The master secret of the organizations' channel keys (D-082), at least 32 characters.
CHANNEL_KEY_MASTER=
# Shared by the environment badge and the counter receipts: sandbox, staging or production.
VITE_APP_ENV=
# DISPLAY_TIMEZONE_DEFAULT=Asia/Ho_Chi_Minh
# BCRYPT_COST=12

# ---- Required at start, unused by the host's work ----
# No browser signs in here, so any long random value works; do not reuse the Vercel secret.
JWT_ACCESS_SECRET=
