# Caddy on the AWS field host (specs/platform/design.md §2.5). It is the host's only ACME client: it
# obtains and renews the Let's Encrypt certificate of MQTT_DOMAIN (HTTP-01 on port 80), which the broker
# also uses for MQTT over TLS on 8883 (mosquitto/start.sh). On 443 it serves the backend's health check and
# nothing else; the broker hooks and the rest of the API stay on the compose network.
{
	email {$ACME_EMAIL}
	# Let's Encrypt only, so the certificate stays under the folder mosquitto/start.sh reads.
	cert_issuer acme
	servers {
		protocols h1 h2
	}
}

{$MQTT_DOMAIN} {
	handle /api/health {
		reverse_proxy backend:3000
	}
	handle {
		respond "Not found" 404
	}
}
