# Caddy on the AWS host (specs/platform/design.md §2.5, RUNBOOK.md). It is the host's only ACME client: it
# obtains and renews the Let's Encrypt certificate of MQTT_DOMAIN (HTTP-01 on port 80), which the broker
# also uses for MQTT over TLS on 8883 (mosquitto/start.sh). On 443 it serves the backend's public API
# (/api/*) and the live socket (/socket.io/*, WebSocket upgrade included, which reverse_proxy passes on by
# itself), and every other path from the web app build in /srv/www/current, with index.html for the
# client-side routes (one-command deploy, 2026-11-10; the web app is on the host until the account may use
# CloudFront). The broker hooks (/api/internal/*) stay on the compose network: 443 answers 404 for them.
{
	email {$ACME_EMAIL}
	# Let's Encrypt only, so the certificate stays under the folder mosquitto/start.sh reads.
	cert_issuer acme
	servers {
		protocols h1 h2
	}
}

{$MQTT_DOMAIN} {
	# The broker hooks answer on the compose network only.
	handle /api/internal/* {
		respond "Not found" 404
	}
	handle /api/* {
		reverse_proxy backend:3000
	}
	# Socket.io: long polling and the WebSocket upgrade, which reverse_proxy passes on by itself.
	handle /socket.io/* {
		reverse_proxy backend:3000
	}
	# The web app. Hashed files under /assets/ are cached for a year when they exist; a missing one is a
	# plain 404, never index.html, so a browser cannot cache HTML under a script name.
	handle /assets/* {
		root * /srv/www/current
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Everything else is revalidated, and a path with no file is a client route answered with index.html.
	handle {
		root * /srv/www/current
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
