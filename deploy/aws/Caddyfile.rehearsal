# Rehearsal only (compose.rehearsal.yml): Caddy's internal CA in place of Let's Encrypt, so the stack runs
# where the host name has no public DNS. The API, socket and hook routes match the production Caddyfile;
# the rehearsal serves no web app, so other paths answer 404.
{
	local_certs
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

{$MQTT_DOMAIN} {
	# The broker hooks answer on the compose network only.
	handle /api/internal/* {
		respond "Not found" 404
	}
	handle /api/* {
		reverse_proxy backend:3000
	}
	# Socket.io: long polling and the WebSocket upgrade, which reverse_proxy passes on by itself.
	handle /socket.io/* {
		reverse_proxy backend:3000
	}
	handle {
		respond "Not found" 404
	}
}
