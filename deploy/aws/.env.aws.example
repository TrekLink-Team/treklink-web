# Settings and secrets of the one-command AWS deploy (deploy/aws/RUNBOOK.md, "One command (2026-11-10)").
# Copy this file to deploy/aws/.env.aws on your laptop, fill in the values, and keep it there: it is
# git-ignored (deploy/aws/.gitignore). up.sh reads it, never sources it, and stores each value sent to the
# host as a SecureString under /treklink/<stage>/ in SSM Parameter Store. The host writes deploy/aws/.env
# from those parameters on every deploy. No value below is real.
#
# Format: one KEY=value per line. No `export`, no comment after a value, no line breaks or single quotes
# inside a value. A value may be wrapped in double or single quotes; the quotes are removed. An empty
# value (KEY=) is not sent, and a key removed from this file is removed from SSM on the next up.sh.
#
# Computed by up.sh and the host, refused here: MQTT_DOMAIN and the API host name (the Elastic IP with
# dashes on sslip.io), CORS_ORIGINS (the CloudFront origin plus CORS_EXTRA_ORIGINS), FIELD_STATION_BROKER_URL
# (mqtts://<host name>:8883), BACKEND_TAG (the deployed commit), VITE_API_BASE_URL and VITE_WS_URL.
# Fixed by compose.yml whatever is set here: NODE_ENV=production, PORT_BACKEND, MQTT_BROKER_URL,
# MQTT_INGESTION_ENABLED=true, JOBS_TICK_ON_REQUEST=false, FIELD_SIMULATOR_ENABLED=false, the DEMO_*
# switches off, SWAGGER_ENABLED=false, HANDOVER_NOTE_STORE=database.

# ---- Read by up.sh only, never sent to the host ----
# Receives the 80 % alert of the monthly AWS budget the stack creates.
BUDGET_EMAIL=
# Optional: the monthly budget in USD (default 40).
# BUDGET_LIMIT_USD=40
# Optional: where the web app is served, host (Caddy on the EC2 host, the default) or cloudfront (S3 and
# CloudFront; the account must first be verified by AWS Support for CloudFront).
# FRONTEND_HOSTING=host

# ---- Certificate ----
# The address Let's Encrypt writes to about the certificate of the sslip.io host name.
ACME_EMAIL=
# Optional: seconds between the broker's checks for a renewed certificate (default 3600).
# CERT_CHECK_SECONDS=3600

# ---- Database: Neon (stays the database, Singapore) ----
# The host's own role `treklink_field` on treklink_prod, branch vercel-prod, which reads and writes rows
# and has no DDL right (RUNBOOK.md, manual path §5, creates it). The POOLED string in both. The host never
# runs `prisma migrate` or a seed: the Vercel production build migrates.
DATABASE_URL=
DATABASE_DIRECT_URL=

# ---- Broker (gateway-sync design §4) ----
# Hexadecimal, at least 16 characters: openssl rand -hex 32.
MQTT_AUTH_HOOK_SECRET=
# The backend subscriber's credential.
MQTT_USERNAME=treklink-backend
MQTT_PASSWORD=
# The password every Wi-Fi node (node-<nodeId>) and its phone proxy present, at least 16 characters.
MQTT_NODE_PASSWORD=
# Field Station uplinks on their data topic (gateway-sync design §4).
MQTT_STATION_UPLINK_ENABLED=true
# Optional: the topic root (frozen by D-005) and the subscriber's client id, which keys its persistent
# session on this broker.
# MQTT_ROOT=treklink
# MQTT_CLIENT_ID_BACKEND=treklink-backend-aws

# ---- Browser access ----
# Optional: more origins allowed to call the API, comma-separated, added after the CloudFront origin.
# CORS_EXTRA_ORIGINS=
# Signs the access tokens of every browser session on this host, at least 32 random characters
# (openssl rand -hex 32). Do not reuse the Vercel secret.
JWT_ACCESS_SECRET=
# Optional (auth requirements §4): JWT_ACCESS_TTL=15m, JWT_REFRESH_TTL=14d, BCRYPT_COST=12.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=14d
# BCRYPT_COST=12

# ---- The same values as the Vercel production ----
# NODE_ENV=production refuses the console mail transport and the placeholder tax code and hotline.
MAIL_TRANSPORT=smtp
SMTP_URL=
MAIL_FROM=
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_CODE=
COMPANY_HOTLINE=
HANDOVER_PLACE=
# The master secret of the organizations' channel keys (D-082), at least 32 characters.
CHANNEL_KEY_MASTER=
# Shared by the environment badge of the web app and the counter receipts: sandbox, staging or production.
VITE_APP_ENV=staging
# Optional: DISPLAY_TIMEZONE_DEFAULT=Asia/Ho_Chi_Minh
# DISPLAY_TIMEZONE_DEFAULT=Asia/Ho_Chi_Minh

# ---- Optional backend settings (backend/src/modules/platform/config/environment-variables.ts) ----
# SePay (billing): without SEPAY_WEBHOOK_API_KEY every webhook call is refused.
# SEPAY_WEBHOOK_API_KEY=
# SEPAY_BANK_CODE=MBBank
# SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
# A read-only GitHub token for the firmware release reader (no scope).
# GITHUB_TOKEN=
# HTTP_BODY_LIMIT=1mb
# RENTALS_HANDOVER_BODY_LIMIT=2mb
