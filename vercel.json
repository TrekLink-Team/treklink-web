{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "nestjs",
      "installCommand": "bash ../scripts/vercel-install.sh",
      "buildCommand": "bash scripts/vercel-build.sh"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "bash ../scripts/vercel-install.sh",
      "buildCommand": "VITE_LIVE_MODE=poll NODE_ENV=production npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
