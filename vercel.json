{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "nestjs",
      "installCommand": "cd .. && npm ci --workspace=backend",
      "buildCommand": "bash scripts/vercel-build.sh"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "cd .. && npm ci --workspace=frontend --ignore-scripts",
      "buildCommand": "NODE_ENV=production npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
