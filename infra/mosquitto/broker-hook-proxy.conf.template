# broker-hook-proxy (docker-compose.broker-auth.yml): go-auth's HTTP backend sends no custom header,
# so this proxy adds X-Broker-Secret to its calls and forwards them to the backend. The nginx image
# fills ${MQTT_AUTH_HOOK_SECRET} and ${BROKER_HOOK_BACKEND} from the environment at start. It is
# reachable only on the compose network, serves the two hook paths only, and logs no headers.
# MQTT_AUTH_HOOK_SECRET must be hexadecimal (`openssl rand -hex 32`): it is written inside a
# double-quoted nginx string, where a quote, a dollar sign or a backslash would break the header.
server {
    listen 8080;

    location = /api/internal/mqtt/user {
        proxy_pass ${BROKER_HOOK_BACKEND};
        proxy_set_header X-Broker-Secret "${MQTT_AUTH_HOOK_SECRET}";
    }

    location = /api/internal/mqtt/acl {
        proxy_pass ${BROKER_HOOK_BACKEND};
        proxy_set_header X-Broker-Secret "${MQTT_AUTH_HOOK_SECRET}";
    }

    location / {
        return 404;
    }
}
